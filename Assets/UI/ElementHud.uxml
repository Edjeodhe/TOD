<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/ElementHud.uss" />
    <!-- 16차: 층 암시 문구(화면 가운데)와 부가 세트 충전 게이지(왼쪽 아래). ElementHud.cs 가 채운다. -->
    <ui:VisualElement name="element-root" class="element-root" picking-mode="Ignore">
        <ui:VisualElement name="floor-hint" class="floor-hint hidden" picking-mode="Ignore">
            <ui:Label name="floor-hint-text" class="floor-hint-text" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="proc-gauges" class="proc-gauges" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
