<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Button name="card" class="choice">
        <ui:VisualElement name="icon" class="icon" picking-mode="Ignore" />
        <ui:Label name="tag" class="tag-line" picking-mode="Ignore" />
        <ui:Label name="name" class="name" picking-mode="Ignore" />
        <ui:Label name="text" class="text" picking-mode="Ignore" />
        <ui:Label name="foot" class="foot" picking-mode="Ignore" />
    </ui:Button>
</ui:UXML>
