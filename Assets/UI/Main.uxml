<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Main.uss" />
    <Style src="project://database/Assets/UI/Puzzle.uss" />
    <Style src="project://database/Assets/UI/DevTools.uss" />
    <Style src="project://database/Assets/UI/Outgame.uss" />
    <Style src="project://database/Assets/UI/Hub.uss" />
    <Style src="project://database/Assets/UI/Merchant.uss" />
    <Style src="project://database/Assets/UI/Moira.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">

        <!-- 전투 중 글자 (피해 숫자, N HIT, ×N) -->
        <ui:VisualElement name="world-text" class="layer" picking-mode="Ignore" />

        <!-- 전투 HUD -->
        <ui:VisualElement name="hud" class="layer hud hidden" picking-mode="Ignore">
            <ui:VisualElement class="panel status" picking-mode="Ignore">
                <ui:VisualElement class="section-head" picking-mode="Ignore">
                    <ui:Label text="◇" class="mark" />
                    <ui:Label text="재봉사의 상태" class="heading" />
                    <ui:Label name="level" text="LV. 1" class="tag" />
                </ui:VisualElement>
                <ui:VisualElement class="stat" picking-mode="Ignore">
                    <ui:VisualElement class="stat-label" picking-mode="Ignore">
                        <ui:VisualElement class="icon" style="background-image: url('project://database/Assets/sprites/icon_heart.png');" />
                        <ui:Label text="체력" />
                        <ui:Label name="hp-value" text="100 / 100" class="value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="bar-frame small" picking-mode="Ignore">
                        <ui:VisualElement class="bar-track meter" picking-mode="Ignore"><ui:VisualElement name="hp-heal" class="meter-fill heal" picking-mode="Ignore" /><ui:VisualElement name="hp-bar" class="meter-fill health" picking-mode="Ignore" /></ui:VisualElement>
                        <ui:VisualElement class="bar-ink" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="stat" picking-mode="Ignore">
                    <ui:VisualElement class="stat-label" picking-mode="Ignore">
                        <ui:VisualElement class="icon" style="background-image: url('project://database/Assets/sprites/icon_yarn.png');" />
                        <ui:Label text="털실" />
                        <ui:Label name="yarn-value" text="6 / 6" class="value" />
                    </ui:VisualElement>
                    <ui:VisualElement name="yarn-pips" class="yarn-pips" />
                    <ui:VisualElement class="thread-status" picking-mode="Ignore">
                        <ui:Label name="thread-count" text="실 0가닥" />
                        <ui:Label name="knot-ready" text="매듭까지 5발" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="stat" picking-mode="Ignore">
                    <ui:VisualElement class="stat-label" picking-mode="Ignore">
                        <ui:VisualElement class="icon" style="background-image: url('project://database/Assets/sprites/icon_desire.png');" />
                        <ui:Label text="욕망" />
                        <ui:Label name="desire-value" text="0 / 100" class="value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="bar-frame small" picking-mode="Ignore">
                        <ui:VisualElement class="bar-track meter" picking-mode="Ignore"><ui:VisualElement name="desire-bar" class="meter-fill desire" picking-mode="Ignore" /></ui:VisualElement>
                        <ui:VisualElement class="bar-ink" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="stat" picking-mode="Ignore">
                    <ui:VisualElement class="stat-label" picking-mode="Ignore">
                        <ui:VisualElement class="icon dash-icon" />
                        <ui:Label text="대쉬" />
                        <ui:Label name="dash-value" text="2 / 2" class="value" />
                    </ui:VisualElement>
                    <ui:VisualElement name="dash-pips" class="dash-pips" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="status-bottom" picking-mode="Ignore">
                    <ui:VisualElement>
                        <ui:VisualElement class="icon" style="background-image: url('project://database/Assets/sprites/icon_gold.png');" />
                        <ui:Label text="골드" />
                        <ui:Label name="gold" text="0" class="value" />
                    </ui:VisualElement>
                    <ui:VisualElement>
                        <ui:VisualElement class="icon" style="background-image: url('project://database/Assets/sprites/icon_knot.png');" />
                        <ui:Label text="매듭" />
                        <ui:Label name="knots" text="0" class="value" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="panel route" picking-mode="Ignore">
                <ui:VisualElement class="section-head" picking-mode="Ignore">
                    <ui:Label text="◇" class="mark" />
                    <ui:Label text="등반 기록" class="heading" />
                    <ui:Label name="floor-label" text="01F" class="tag" />
                </ui:VisualElement>
                <ui:VisualElement name="rounds" picking-mode="Ignore">
                    <ui:VisualElement class="round current"><ui:Label text="1" class="num" /><ui:Label name="round-name-1" text="생존" /></ui:VisualElement>
                    <ui:VisualElement class="round"><ui:Label text="2" class="num" /><ui:Label name="round-name-2" text="생존" /></ui:VisualElement>
                    <ui:VisualElement class="round"><ui:Label text="✧" class="num" /><ui:Label name="round-name-3" text="쉬어가기" /></ui:VisualElement>
                    <ui:VisualElement class="round"><ui:Label text="♜" class="num" /><ui:Label name="round-name-4" text="층 보스" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="route-info" text="층마다 세 라운드를 돌파하세요." class="route-info" />
            </ui:VisualElement>

            <ui:Button name="pause" text="Ⅱ" class="icon-button pause-button" tooltip="일시 정지 (Esc)" />
            <ui:VisualElement name="banner" class="banner hidden" picking-mode="Ignore"><ui:Label name="banner-text" /></ui:VisualElement>
            <ui:VisualElement name="timer" class="round-timer hidden" picking-mode="Ignore"><ui:Label name="timer-text" /></ui:VisualElement>
            <ui:VisualElement name="hint" class="hint-bar hidden" picking-mode="Ignore"><ui:Label name="hint-text" /></ui:VisualElement>
            <!-- 보스 HUD: 화면 위 가운데, 크게 (이름 띠 + 잉크 틀 게이지) -->
            <ui:VisualElement name="boss-hud" class="boss-hud hidden" picking-mode="Ignore">
                <ui:VisualElement class="boss-title" picking-mode="Ignore">
                    <ui:VisualElement class="boss-seal" picking-mode="Ignore"><ui:Label text="♜" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:Label name="boss-name" text="실타래의 지배자" class="boss-name" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="bar-frame boss-frame" picking-mode="Ignore">
                    <ui:VisualElement class="bar-track meter" picking-mode="Ignore"><ui:VisualElement name="boss-bar" class="meter-fill boss" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="bar-ink" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- 메이플식 하단 경험치 바 -->
            <ui:VisualElement name="exp" class="exp-bar" picking-mode="Ignore">
                <ui:Label name="exp-level" text="LV. 1" class="exp-level" />
                <ui:VisualElement class="bar-frame exp-frame" picking-mode="Ignore">
                    <ui:VisualElement class="bar-track exp-track" picking-mode="Ignore">
                        <ui:VisualElement name="exp-fill" class="exp-fill" picking-mode="Ignore"><ui:VisualElement class="exp-shine" picking-mode="Ignore" /></ui:VisualElement>
                        <ui:VisualElement class="exp-tick" style="left: 10%;" /><ui:VisualElement class="exp-tick" style="left: 20%;" /><ui:VisualElement class="exp-tick" style="left: 30%;" /><ui:VisualElement class="exp-tick" style="left: 40%;" /><ui:VisualElement class="exp-tick" style="left: 50%;" /><ui:VisualElement class="exp-tick" style="left: 60%;" /><ui:VisualElement class="exp-tick" style="left: 70%;" /><ui:VisualElement class="exp-tick" style="left: 80%;" /><ui:VisualElement class="exp-tick" style="left: 90%;" />
                        <ui:Label name="exp-text" text="EXP 0 / 5 [0.00%]" class="exp-text" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="bar-ink" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="controls-hint" picking-mode="Ignore">
                <ui:Label text="WASD 이동" />
                <ui:Label text="좌클릭 바늘 발사" />
                <ui:Label text="우클릭 실 당기기" />
                <ui:Label text="Space 대쉬" />
                <ui:Label text="E 상호작용" />
                <ui:Label text="Esc 일시 정지" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 로비 = 15차 재봉실 허브: 방과 시설은 씬 Hub(월드)가 그리고, 여기에는 위쪽 띠와 꼬리표, 아래 안내만 (GameUI.Hub.cs, Hub.uss) -->
        <ui:VisualElement name="lobby" class="layer lobby hub-layer" picking-mode="Ignore">
            <ui:VisualElement class="hub-vignette" picking-mode="Ignore" />
            <ui:VisualElement class="topbar">
                <ui:VisualElement class="brand">
                    <ui:VisualElement class="brand-icon"><ui:VisualElement /></ui:VisualElement>
                    <ui:VisualElement>
                        <ui:Label text="재봉실" class="brand-name" />
                        <ui:Label text="탑 아래 작업실" class="brand-sub" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="shards" tooltip="기억의 파편"><ui:VisualElement /><ui:Label name="meta-shards" text="0" /></ui:VisualElement>
                <ui:Button name="sound" text="♪" class="icon-button" tooltip="소리 켜기/끄기" />
            </ui:VisualElement>
            <ui:VisualElement name="hub-prompt" class="hub-prompt hidden" picking-mode="Ignore">
                <ui:VisualElement class="hub-prompt-tag" picking-mode="Ignore">
                    <ui:Label text="E" class="kbd" picking-mode="Ignore" />
                    <ui:Label name="hub-prompt-text" class="hub-prompt-text" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hub-bottom" picking-mode="Ignore">
                <ui:Label name="hub-hint" class="hub-hint" picking-mode="Ignore" />
                <ui:Label name="best-record" text="◇ 최고 기록  미기록" class="record hub-record" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="hub-menu">
                <ui:Button name="start" text="Enter  등반 시작" class="primary start-button hub-start" />
                <ui:Button name="open-attic" text="예견의 다락" class="hidden" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 재봉 상자: 등반 중(I), 19차부터 아웃게임에서는 단추의 '시작 조각 챙기기'와 모이라의 줄 고르기 판으로만 연다 -->
        <ui:VisualElement name="inventory" class="layer room hidden">
            <ui:VisualElement class="room-body sewing-body">
                <ui:Label name="inventory-header" class="eyebrow" />
                <ui:Label name="inventory-title" text="재봉 상자" class="room-title" />
                <ui:Label name="inventory-run-note" class="room-note hidden" />
                <ui:Label name="inventory-help" text="조각을 고르고(R로 회전) 판의 칸을 누르세요. 같은 색의 변을 맞대면 세트 효과가 켜집니다." class="room-text" />
                <ui:VisualElement class="inventory-layout">
                    <!-- 세트 효과 패널 (22차): 판에 가진 세트만, 이름 (개수) + 켜진 효과 짧게, 못 미친 세트는 회색. 마우스를 올리면 set-tip (GameUI 가 Slots.uxml set-entry 를 복제) -->
                    <ui:VisualElement name="sets" class="set-panel">
                        <ui:Label text="세트 효과" class="set-panel-title" />
                        <ui:ScrollView name="set-list" class="set-list" mode="Vertical" horizontal-scroller-visibility="Hidden" />
                        <ui:Label name="set-empty" text="판에 조각을 놓으면 여기에 세트가 나옵니다." class="set-empty" />
                    </ui:VisualElement>
                    <!-- 판: 칸(누르기) 위에 조각 그림 층과 반투명 미리보기 층을 겹친다 -->
                    <ui:VisualElement name="board-wrap" class="board-wrap">
                        <ui:VisualElement name="board" class="board" />
                        <ui:VisualElement name="board-pieces" class="board-layer" picking-mode="Ignore" />
                        <ui:VisualElement name="board-ghost" class="board-layer board-ghost" picking-mode="Ignore" />
                        <!-- 21차 강화한 칸의 "+N" 숫자 (조각 그림 위) -->
                        <ui:VisualElement name="board-badges" class="board-layer" picking-mode="Ignore" />
                        <!-- 19차 모이라 줄 고르기: 강화한 줄 띠, 확장 가장자리 띠(누름) -->
                        <ui:VisualElement name="board-pick" class="board-layer board-pick" picking-mode="Ignore" />
                        <ui:VisualElement name="needle" class="sew-needle hidden" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <!-- 21차 목록 + 오른쪽 위 정렬 버튼 (누르면 기준 목록이 펼쳐짐, GameUI.Board.cs InitSort) -->
                    <ui:VisualElement name="stash-col" class="stash-col">
                        <ui:VisualElement name="stash-head" class="stash-head">
                            <ui:Button name="stash-sort" text="등급순  ▼" class="stash-sort" />
                        </ui:VisualElement>
                        <ui:ScrollView name="stash" class="stash" mode="Vertical" horizontal-scroller-visibility="Hidden" />
                        <!-- 목록보다 뒤에 둬야 목록 위에 그려진다 -->
                        <ui:VisualElement name="stash-sort-menu" class="stash-sort-menu">
                            <ui:Button name="sort-grade" text="등급순" class="sort-option" />
                            <ui:Button name="sort-set" text="속성순" class="sort-option" />
                            <ui:Button name="sort-acquired" text="획득순" class="sort-option" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="actions">
                    <ui:Button name="rotate" text="회전 (R)" />
                    <ui:Button name="unequip" text="판에서 빼기" />
                    <ui:Button name="inventory-back" text="돌아가기" class="primary" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- 꾹 눌러 끌 때 손끝을 따라오는 반투명 조각 (GameUI 가 조각 그림을 채움, 놓으면 사라짐) -->
            <ui:VisualElement name="drag-piece" class="drag-piece hidden" picking-mode="Ignore" />
            <!-- 아이템 정보 창 (목록·판의 조각에 마우스를 올리면 따라다니고, 떼면 사라짐) -->
            <ui:VisualElement name="piece-tip" class="piece-tip hidden" picking-mode="Ignore">
                <ui:VisualElement class="tip-head" picking-mode="Ignore">
                    <ui:VisualElement name="tip-icon" class="tip-icon" picking-mode="Ignore" />
                    <ui:VisualElement class="tip-title" picking-mode="Ignore">
                        <ui:Label name="tip-set-name" class="tip-set-name" picking-mode="Ignore" />
                        <ui:Label name="tip-name" class="tip-name" picking-mode="Ignore" />
                        <ui:Label name="tip-rank" class="tip-rank" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="tip-shape" class="tip-shape" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="tip-cells" class="tip-line" picking-mode="Ignore" />
                <ui:Label name="tip-effect" class="tip-effect" picking-mode="Ignore" />
                <ui:Label name="tip-unique" class="tip-unique" picking-mode="Ignore" />
                <ui:VisualElement class="tip-set-row" picking-mode="Ignore">
                    <ui:VisualElement name="tip-knot" class="tip-knot" picking-mode="Ignore" />
                    <ui:Label name="tip-set" class="tip-line" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="tip-flavor" class="tip-flavor" picking-mode="Ignore" />
            </ui:VisualElement>
            <!-- 22차 세트 정보 창 (세트 효과 패널의 줄에 마우스를 올리면): 이름(죄종 색), 설명, 단계마다 한 줄 (달성 흰색, 못 달성 회색) -->
            <ui:VisualElement name="set-tip" class="set-tip hidden" picking-mode="Ignore">
                <ui:VisualElement class="set-tip-head" picking-mode="Ignore">
                    <ui:Label name="set-tip-name" class="set-tip-name" picking-mode="Ignore" />
                    <ui:Label name="set-tip-count" class="set-tip-count" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="set-tip-role" class="set-tip-role" picking-mode="Ignore" />
                <ui:Label name="set-tip-desc" class="set-tip-desc" picking-mode="Ignore" />
                <ui:VisualElement name="set-tip-tiers" class="set-tip-tiers" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 예견의 다락: 19차 모이라 카드 창 (다락 방이 뒤에 비침). 모이라가 든 카드 넷이 손에서 날아와 펼쳐진다 (GameUI.Moira.cs, Moira.uss) -->
        <ui:VisualElement name="attic" class="layer room attic moira-layer hidden">
            <ui:VisualElement class="room-shade" picking-mode="Ignore" />
            <ui:VisualElement class="moira-head" picking-mode="Ignore">
                <ui:Label name="attic-eyebrow" text="✧  예견의 다락" class="eyebrow" picking-mode="Ignore" />
                <ui:Label name="attic-title" text="모이라" class="moira-title" picking-mode="Ignore" />
                <ui:Label name="moira-line" class="moira-line" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="shards moira-shards" tooltip="기억의 파편" picking-mode="Ignore"><ui:VisualElement picking-mode="Ignore" /><ui:Label name="attic-shards" text="0" picking-mode="Ignore" /></ui:VisualElement>
            <ui:VisualElement name="moira-cards" class="moira-cards" picking-mode="Ignore" />
            <ui:Label name="moira-hint" class="moira-hint" picking-mode="Ignore" />
            <ui:Button name="attic-back" text="돌아가기 (Esc)" class="moira-back" />
            <!-- 22차 욕망 최대치 강화 연출 (GameUI.Vessel.cs, Moira.uss): 카드 위 욕망 게이지가 이전 최대치 → 새 최대치로 자란다 -->
            <ui:VisualElement name="vessel" class="vessel hidden" picking-mode="Ignore">
                <ui:VisualElement name="vessel-halo" class="vessel-halo" picking-mode="Ignore" />
                <ui:Label name="vessel-title" class="vessel-title" picking-mode="Ignore" />
                <ui:VisualElement class="vessel-row" picking-mode="Ignore">
                    <ui:VisualElement class="vessel-icon" picking-mode="Ignore" />
                    <ui:VisualElement name="vessel-bar" class="bar-frame vessel-bar" picking-mode="Ignore">
                        <ui:VisualElement class="bar-track meter" picking-mode="Ignore">
                            <ui:VisualElement name="vessel-fill" class="meter-fill desire vessel-fill" picking-mode="Ignore" />
                            <ui:VisualElement name="vessel-new" class="meter-fill vessel-new" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="bar-ink" picking-mode="Ignore" />
                        <ui:VisualElement name="vessel-mark" class="vessel-mark" picking-mode="Ignore" />
                        <ui:VisualElement name="vessel-glint" class="vessel-glint" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="vessel-value" class="vessel-value" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="vessel-line-0" class="vessel-line" picking-mode="Ignore" />
                <ui:Label name="vessel-line-1" class="vessel-line" picking-mode="Ignore" />
                <ui:Label name="vessel-line-2" class="vessel-line" picking-mode="Ignore" />
            </ui:VisualElement>
            <!-- 22차 미래 보기 연출 (GameUI.FateShow.cs, 방 쪽은 씬 Hub/Moira/FateOrb): 점성구가 떠오름 → 파편 불티 → 자세히 살펴보기(E) → 빨려 드는 줌 → 구슬 속 영상과 자막 -->
            <ui:VisualElement name="fate" class="fate hidden">
                <ui:VisualElement name="fate-dim" class="fate-dim" picking-mode="Ignore" />
                <ui:VisualElement name="fate-prompt" class="hub-prompt fate-prompt" picking-mode="Ignore">
                    <ui:VisualElement class="hub-prompt-tag" picking-mode="Ignore">
                        <ui:Label text="E" class="kbd" picking-mode="Ignore" />
                        <ui:Label name="fate-prompt-text" class="hub-prompt-text" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="fate-sparks" class="fate-sparks" picking-mode="Ignore">
                    <ui:VisualElement class="fate-spark" picking-mode="Ignore" />
                    <ui:VisualElement class="fate-spark" picking-mode="Ignore" />
                    <ui:VisualElement class="fate-spark" picking-mode="Ignore" />
                    <ui:VisualElement class="fate-spark" picking-mode="Ignore" />
                    <ui:VisualElement class="fate-spark" picking-mode="Ignore" />
                    <ui:VisualElement class="fate-spark" picking-mode="Ignore" />
                    <ui:VisualElement class="fate-spark" picking-mode="Ignore" />
                    <ui:VisualElement class="fate-spark" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="fate-text" class="fate-text" picking-mode="Ignore" />
                <ui:Label name="fate-skip" class="fate-skip" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 등반 결과 -->
        <ui:VisualElement name="summary" class="layer room hidden">
            <ui:VisualElement class="room-body">
                <ui:VisualElement name="summary-vfx" class="ui-vfx" picking-mode="Ignore" />
                <ui:Label text="✧  등반 결과" class="eyebrow" />
                <ui:Label name="summary-title" class="room-title" />
                <ui:Label name="summary-body" class="room-text" />
                <ui:VisualElement class="actions">
                    <ui:Button name="restart" text="다시 등반" class="primary" />
                    <ui:Button name="summary-attic" text="예견의 다락" />
                    <ui:Button name="summary-lobby" text="재봉실로" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 대화 상자 -->
        <!-- 16차 상인 단추 월드 말풍선 (GameUI.Merchant.cs) -->
        <ui:VisualElement name="merchant-world" class="layer" picking-mode="Ignore" />

        <ui:VisualElement name="overlay" class="layer overlay hidden">
            <ui:VisualElement name="dialog-pause" class="dialog hidden">
                <ui:Label text="등반 중" class="eyebrow" />
                <ui:Label text="일시 정지" class="dialog-title" />
                <ui:Label text="전투를 계속하거나 기억의 파편을 가지고 귀환할 수 있습니다." class="dialog-text" />
                <ui:VisualElement class="actions">
                    <ui:Button name="resume" text="계속하기" class="primary" />
                    <ui:Button name="retreat" text="다락으로 귀환" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="dialog-retreat" class="dialog hidden">
                <ui:Label text="등반 종료" class="eyebrow" />
                <ui:Label text="지금 귀환할까요?" class="dialog-title" />
                <ui:Label text="모은 기억의 파편과 장비는 가지고 돌아갑니다. 이번 등반의 골드와 증강은 사라집니다." class="dialog-text" />
                <ui:VisualElement class="actions">
                    <ui:Button name="confirm-retreat" text="귀환하기" class="primary" />
                    <ui:Button name="cancel-retreat" text="계속하기" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="dialog-augment" class="dialog hidden">
                <ui:Label text="증강 선택" class="eyebrow" />
                <ui:Label name="augment-title" class="dialog-title" />
                <ui:Label text="올릴 능력치 하나를 고르세요. Esc로 닫고 나중에 E로 다시 열 수 있습니다." class="dialog-text" />
                <ui:VisualElement name="augment-choices" class="puzzle-grid" />
                <ui:VisualElement class="actions reroll-row"><ui:Button name="reroll-augment" text="다시 굴리기" class="reroll" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="dialog-desire" class="dialog hidden">
                <ui:VisualElement class="ui-vfx" picking-mode="Ignore" style="background-image: url('project://database/Assets/vfx/boss.png');" />
                <ui:Label name="desire-eyebrow" class="eyebrow" />
                <ui:Label name="desire-name" class="dialog-title" />
                <ui:Label name="desire-text" class="dialog-text" />
                <ui:Label name="desire-penalty" class="dialog-text" />
                <ui:VisualElement class="desire-choices">
                    <ui:VisualElement class="desire-choice">
                        <ui:Button name="absorb" text="욕망 흡수" class="primary" />
                        <ui:Label name="absorb-feel" class="desire-feel" />
                    </ui:VisualElement>
                    <ui:VisualElement class="desire-choice">
                        <ui:Button name="refuse" text="그대로 지나가기" />
                        <ui:Label name="refuse-feel" class="desire-feel" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="desire-numbers" class="desire-numbers" />
            </ui:VisualElement>
            <ui:VisualElement name="dialog-shop" class="dialog hidden">
                <ui:VisualElement class="merchant-peek-slot" picking-mode="Ignore" />
                <ui:Label text="층 사이 휴식처" class="eyebrow" />
                <ui:Label text="떠돌이 상인 단추" class="dialog-title" />
                <ui:Label text="금화를 내고 다음 층에 들고 갈 물품을 고르세요." class="dialog-text" />
                <ui:Label name="sale-label" class="dialog-text" />
                <ui:VisualElement name="wares" class="choice-grid shop-grid" />
                <ui:VisualElement class="actions">
                    <ui:Button name="close-shop" text="닫기" class="primary" />
                    <ui:Button name="shop-retreat" text="귀환" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="dialog-artifact" class="dialog hidden">
                <ui:Label name="artifact-eyebrow" class="eyebrow" />
                <ui:Label text="탑의 조각" class="dialog-title" />
                <ui:Label text="이 층에서 얻을 수 있는 재봉 조각은 하나뿐입니다. 고른 조각은 재봉 상자에 들어갑니다. (Esc: 나중에)" class="dialog-text" />
                <ui:VisualElement name="artifacts" class="puzzle-grid" />
                <ui:VisualElement class="actions reroll-row"><ui:Button name="reroll-artifact" text="다시 굴리기" class="reroll" /><ui:Button name="close-artifact" text="나중에 고르기" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="dialog-hubshop" class="dialog hidden">
                <!-- 20차: 오른쪽 위 상인 얼굴(merchant-peek-slot)은 파편 수와 겹쳐 뺐다 -->
                <ui:Label text="재봉실 한쪽 구석" class="eyebrow" />
                <ui:Label name="hubshop-title" class="dialog-title" />
                <ui:Label name="hubshop-text" class="dialog-text" />
                <ui:VisualElement class="shards hubshop-shards" tooltip="기억의 파편"><ui:VisualElement /><ui:Label name="hubshop-shards" text="0" /></ui:VisualElement>
                <ui:VisualElement name="hub-wares" class="choice-grid hub-wares" />
                <ui:Label name="hubshop-empty" class="dialog-text hidden" />
                <ui:VisualElement class="actions"><ui:Button name="close-hubshop" text="닫기" class="primary" /></ui:VisualElement>
            </ui:VisualElement>
            <!-- 20차 시작 조각 챙기기: 무작위 진열 조각을 증강처럼 카드로 고른다 (GameUI.Hub.cs ShowPackCards). 카드 아래 꼬리표는 HubSlots.uxml hub-price -->
            <ui:VisualElement name="dialog-hubpack" class="dialog hidden">
                <ui:Label name="hubpack-eyebrow" class="eyebrow" />
                <ui:Label name="hubpack-title" class="dialog-title" />
                <ui:Label name="hubpack-status" class="dialog-text hubpack-status" />
                <ui:VisualElement class="shards hubshop-shards" tooltip="기억의 파편"><ui:VisualElement /><ui:Label name="hubpack-shards" text="0" /></ui:VisualElement>
                <ui:VisualElement name="hubpack-cards" class="puzzle-grid hubpack-cards" />
                <ui:VisualElement class="actions"><ui:Button name="hubpack-board" text="재봉 상자에 놓기 (I)" class="primary" /><ui:Button name="close-hubpack" text="닫기" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="dialog-upgrade" class="dialog hidden">
                <ui:Label name="upgrade-eyebrow" text="모이라의 의식" class="eyebrow" />
                <ui:Label name="upgrade-title" text="미래를 읽을까요?" class="dialog-title" />
                <ui:Label name="upgrade-text" class="dialog-text" />
                <ui:VisualElement class="actions">
                    <ui:Button name="confirm-upgrade" text="예, 미래를 읽어요" class="primary" />
                    <ui:Button name="cancel-upgrade" text="취소" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="room-flash" class="room-flash hidden" picking-mode="Ignore"><ui:VisualElement picking-mode="Ignore" /></ui:VisualElement>
        <!-- 17차: 재봉실 ↔ 다락 방을 오갈 때 잠깐 어두워지는 판 -->
        <ui:VisualElement name="room-fade" class="room-fade hidden" picking-mode="Ignore" />
        <ui:VisualElement name="notice" class="notice hidden" picking-mode="Ignore"><ui:Label name="notice-text" /></ui:VisualElement>

        <!-- 15차: 세트 해금 알림 (세트 색 종이 띠 + 이름 + 반짝임, 클릭하면 넘김). GameUI.Outgame.cs, Outgame.uss -->
        <ui:VisualElement name="unlock-notice" class="unlock-notice hidden">
            <ui:VisualElement name="unlock-flash" class="unlock-flash" picking-mode="Ignore" />
            <ui:VisualElement name="unlock-ribbon" class="unlock-ribbon" picking-mode="Ignore">
                <ui:VisualElement class="unlock-shine-clip" picking-mode="Ignore"><ui:VisualElement name="unlock-shine" class="unlock-shine" picking-mode="Ignore" /></ui:VisualElement>
                <ui:Label text="새 세트가 열렸습니다" class="unlock-eyebrow" picking-mode="Ignore" />
                <ui:Label name="unlock-name" class="unlock-name" picking-mode="Ignore" />
                <ui:Label name="unlock-text" class="unlock-text" picking-mode="Ignore" />
                <ui:Label text="이제 탑과 상인에게서 이 세트의 조각이 나옵니다" class="unlock-foot" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="unlock-sparks" picking-mode="Ignore">
                <ui:Label text="✧" class="unlock-spark s1" picking-mode="Ignore" />
                <ui:Label text="✧" class="unlock-spark s2" picking-mode="Ignore" />
                <ui:Label text="✧" class="unlock-spark s3" picking-mode="Ignore" />
                <ui:Label text="✧" class="unlock-spark s4" picking-mode="Ignore" />
                <ui:Label text="✧" class="unlock-spark s5" picking-mode="Ignore" />
                <ui:Label text="✧" class="unlock-spark s6" picking-mode="Ignore" />
                <ui:Label text="✧" class="unlock-spark s7" picking-mode="Ignore" />
                <ui:Label text="✧" class="unlock-spark s8" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 개발자 모드 (F1, 에디터·개발 빌드만). DevTools 가 버튼을 연결하고, 세트 버튼은 DevSetButton.uxml 을 복제한다. -->
        <ui:VisualElement name="dev-panel" class="dev-panel hidden">
            <ui:Label text="개발자 모드 (F1)" class="dev-title" />
            <ui:Label name="dev-status" class="dev-status" />
            <ui:Label text="주인공" class="dev-head" />
            <ui:VisualElement class="dev-row">
                <ui:Button name="dev-god" text="무적" class="dev-btn" />
                <ui:Button name="dev-heal" text="체력 회복" class="dev-btn" />
                <ui:Button name="dev-level" text="레벨 +1" class="dev-btn" />
                <ui:Button name="dev-yarn" text="털실 채우기" class="dev-btn" />
            </ui:VisualElement>
            <ui:VisualElement class="dev-row">
                <ui:Button name="dev-gold" text="골드 +" class="dev-btn" />
                <ui:Button name="dev-shards" text="파편 +" class="dev-btn" />
                <ui:Button name="dev-desire-up" text="욕망 +" class="dev-btn" />
                <ui:Button name="dev-desire-down" text="욕망 −" class="dev-btn" />
            </ui:VisualElement>
            <ui:Label text="전투" class="dev-head" />
            <ui:VisualElement class="dev-row">
                <ui:Button name="dev-spawn-stalker" text="스토커" class="dev-btn" />
                <ui:Button name="dev-spawn-charger" text="차저" class="dev-btn" />
                <ui:Button name="dev-spawn-shooter" text="슈터" class="dev-btn" />
                <ui:Button name="dev-spawn-boss" text="보스" class="dev-btn" />
            </ui:VisualElement>
            <ui:VisualElement class="dev-row">
                <ui:Button name="dev-bind" text="결박 실 걸기" class="dev-btn" />
                <ui:Button name="dev-kill" text="적 전부 처치" class="dev-btn" />
                <ui:Button name="dev-end-round" text="라운드 끝내기" class="dev-btn" />
                <ui:Button name="dev-freeze" text="적 멈춤" class="dev-btn" />
            </ui:VisualElement>
            <ui:Label text="층 속성 (16차, 누르면 지금 층이 그 속성으로)" class="dev-head" />
            <ui:VisualElement name="dev-floor-elements" class="dev-row" />
            <ui:Label text="재봉 상자 (세트 조각을 판에 바로 붙임)" class="dev-head" />
            <ui:VisualElement name="dev-sets" class="dev-row" />
            <ui:VisualElement class="dev-row">
                <ui:Button name="dev-all-items" text="모든 조각 지급" class="dev-btn" />
                <ui:Button name="dev-clear-board" text="판 비우기" class="dev-btn" />
                <ui:Button name="dev-clear-items" text="조각 전부 버리기" class="dev-btn" />
            </ui:VisualElement>
            <ui:Label text="해금 (15차)" class="dev-head" />
            <ui:VisualElement class="dev-row">
                <ui:Button name="dev-ignore-locks" text="세트 잠금 무시" class="dev-btn" />
                <ui:Button name="dev-best-up" text="최고 층 +1" class="dev-btn" />
                <ui:Button name="dev-best-reset" text="최고 층, 해금 알림 초기화" class="dev-btn" />
                <ui:Button name="dev-unlock-notice" text="해금 알림 보기" class="dev-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
