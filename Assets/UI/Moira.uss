/* 19차 모이라 카드 창 (GameUI.Moira.cs). 카드 그림은 Assets/UI/Moira/card_front.png, card_back.png (데이터 hub.cardFront/Back) */

/* 창: 다락 방이 그대로 보이게 아래쪽만 살짝 어둡게 */
.room.attic.moira-layer { background-image: none; background-color: rgba(0, 0, 0, 0); align-items: stretch; justify-content: flex-start; }
.moira-layer > .room-shade { background-color: rgba(10, 6, 14, 0.28); }
.moira-head { position: absolute; left: 56px; top: 108px; width: 560px; align-items: flex-start; }
.moira-head .eyebrow { color: #d6b06e; }
.moira-title { font-size: 40px; color: #f3e6d0; -unity-text-outline-width: 1px; -unity-text-outline-color: #1a1013; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
/* 모이라의 말 (말을 걸 때마다 한 줄, 운명 읽기의 암시) */
.moira-line {
    margin-top: 6px; max-width: 560px; font-size: 21px; -unity-text-align: middle-left; white-space: normal;
    color: #e4d4f2; -unity-font-style: italic; -unity-text-outline-width: 1px; -unity-text-outline-color: #1a1013;
    padding: 8px 26px; background-color: rgba(26, 16, 32, 0.72); border-radius: 18px; border-width: 1px; border-color: rgba(216, 207, 240, 0.35);
    opacity: 0; translate: 0 8px; transition-property: opacity, translate; transition-duration: 0.35s;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
}
.moira-line.show { opacity: 1; translate: 0 0; }
.moira-shards { position: absolute; top: 112px; right: 60px; margin-right: 0; }
.moira-cards { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.moira-hint { position: absolute; left: 0; right: 0; bottom: 84px; -unity-text-align: middle-center; font-size: 18px; color: #cdbfd8; -unity-text-outline-width: 1px; -unity-text-outline-color: #1a1013; }
.moira-back { position: absolute; left: 40px; bottom: 30px; }

/* 카드 한 장 */
.moira-card {
    position: absolute; margin: 0; padding: 0; min-height: 0; min-width: 0;
    background-image: none; background-color: rgba(0, 0, 0, 0); border-width: 0;
    transition-duration: 0s; translate: 0 0;
}
.moira-card:hover { translate: 0 0; background-color: rgba(0, 0, 0, 0); }
.moira-card:active { scale: 1 1; translate: 0 0; }
.card-glow {
    position: absolute; left: -22px; right: -22px; top: -22px; bottom: -22px; border-radius: 30px; opacity: 0;
    background-color: rgba(214, 190, 255, 0.28); border-width: 4px; border-color: rgba(255, 236, 190, 0.95);
}
.card-inner { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.card-face, .card-back { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.card-face { align-items: center; }
/* 앞면 빈 창(위쪽 2/3) 안 그림, 이름 띠, 설명 칸 (card_front.png 의 비율에 맞춤) */
.card-icon { position: absolute; left: 22%; right: 22%; top: 15%; height: 36%; -unity-background-scale-mode: scale-to-fit; }
.card-name {
    position: absolute; left: 12%; right: 12%; top: 69.5%; height: 8%; -unity-text-align: middle-center;
    font-size: 21px; color: #3a2430; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
}
/* 설명 줄은 보이지 않는다 (사용자 요청: 카드에는 그림, 이름, 가격만) */
.card-text {
    display: none;
    position: absolute; left: 13%; right: 13%; top: 79.5%; height: 13%; -unity-text-align: upper-center; white-space: normal;
    font-size: 13px; color: #eadcf2; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
}
.card-foot {
    position: absolute; left: 10%; right: 10%; bottom: -34px; -unity-text-align: middle-center; font-size: 17px;
    color: #fbeedd; padding: 4px 0 5px 0; background-color: rgba(47, 111, 99, 0.92); border-radius: 12px; border-width: 1px; border-color: #12302a;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
}
.moira-card.locked .card-face { -unity-background-image-tint-color: rgb(150, 140, 155); }
.moira-card.locked .card-icon { opacity: 0.55; }
.moira-card.locked .card-foot { background-color: rgba(106, 82, 79, 0.92); }
/* 카드 위 단계 꼬리표 (위 가운데 별 장식 아래 걸친 작은 띠) */
.card-level {
    position: absolute; top: -16px; left: 28%; right: 28%; -unity-text-align: middle-center; font-size: 17px;
    color: #3a2430; padding: 3px 0 4px 0; background-color: rgb(232, 214, 168); border-radius: 12px; border-width: 2px; border-color: #5a3d2a;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
}
.moira-card.locked .card-level { background-color: rgb(190, 180, 170); }

/* 22차 미래 보기 연출 (GameUI.FateShow.cs). 위치, 투명도는 코드가 매 프레임 정하고, 여기는 모양만. */
.fate { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.fate-dim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(8, 4, 12); opacity: 0; }
.fate-prompt { opacity: 0; }
.fate-sparks { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.fate-spark {
    position: absolute; width: 26px; height: 26px; opacity: 0;
    background-image: url("project://database/Assets/sprites/icon_shard.png"); -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(236, 255, 246);
}
/* 자막: 죄종 색 글자 + 짙은 외곽 (속삭임) */
.fate-text {
    position: absolute; left: 14%; right: 14%; height: 120px; -unity-text-align: middle-center; white-space: normal;
    font-size: 48px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    -unity-text-outline-width: 2.4px; -unity-text-outline-color: rgba(8, 4, 10, 0.95);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 1);
    /* 글자 뒤 어두운 띠 (가장자리가 부드러운 원을 가로로 늘림) */
    background-image: url("project://database/Assets/Art/Generated/soft_disc.png"); -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(6, 2, 8, 0.82);
}
.fate-skip {
    position: absolute; left: 0; right: 0; bottom: 44px; -unity-text-align: middle-center; font-size: 22px; opacity: 0;
    color: rgb(236, 226, 214); -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(10, 5, 12, 0.9);
}
/* 연출 동안 카드와 안내는 숨기고, 구슬로 빨려 드는 동안에는 제목, 파편 수, 방 그늘도 걷는다 */
.attic.fate-on .moira-cards, .attic.fate-on .moira-hint, .attic.fate-on .moira-back { opacity: 0; }
.attic .moira-head, .attic .moira-shards, .attic > .room-shade { transition-property: opacity; transition-duration: 0.5s; }
.attic.fate-zoom .moira-head, .attic.fate-zoom .moira-shards, .attic.fate-zoom > .room-shade { opacity: 0; }

/* 22차 욕망 최대치 강화 연출 (GameUI.Vessel.cs). 게이지 틀 길이, 채움 폭, 투명도는 코드가 매 프레임 정하고, 여기는 모양만.
   게이지는 인게임 욕망 바(Main.uss .bar-frame, .meter-fill.desire)와 같은 잉크 틀과 보라 결을 크게 쓴다. */
.vessel {
    position: absolute; left: 0; right: 0; bottom: 54%; align-items: center; padding: 18px 0 14px 0;
    background-image: url("project://database/Assets/Art/Generated/soft_disc.png"); -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(10, 5, 14, 0.86);
}
.vessel-halo {
    position: absolute; left: 22%; right: 22%; top: 8%; bottom: 8%; opacity: 0;
    background-image: url("project://database/Assets/Art/Generated/soft_disc.png"); -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(214, 150, 236, 0.55);
}
.vessel-title {
    font-size: 30px; color: #f1ddff; margin-bottom: 8px; -unity-text-align: middle-center;
    -unity-text-outline-width: 1.2px; -unity-text-outline-color: #1a0d1f; text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
}
.vessel-row { flex-direction: row; align-items: center; justify-content: center; }
.vessel-icon {
    width: 46px; height: 46px; margin-right: 10px; -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/sprites/icon_desire.png");
}
.vessel-bar { height: 46px; width: 400px; flex-shrink: 0; }
.vessel-bar .bar-track { top: 10px; bottom: 11px; }
.vessel-bar .bar-ink { left: -4px; right: -4px; top: -4px; bottom: -4px; -unity-slice-scale: 0.55px; -unity-background-image-tint-color: #d2bce0; }
.vessel-fill { position: absolute; left: 0; top: 0; bottom: 0; height: auto; border-right-width: 0; }
.vessel-new { position: absolute; top: 0; bottom: 0; height: auto; border-right-width: 2px; -unity-background-image-tint-color: #f0c8ff; }
/* 이전 최대치 자리: 짧은 금빛 바늘땀 */
.vessel-mark { position: absolute; top: 4px; bottom: 4px; width: 3px; background-color: rgba(255, 226, 160, 0.95); border-radius: 2px; opacity: 0; }
.vessel-glint {
    position: absolute; top: -14px; width: 60px; height: 74px; opacity: 0;
    background-image: url("project://database/Assets/UI/Puzzle/sparkle.png"); -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffe9ff;
}
.vessel-value {
    min-width: 96px; margin-left: 30px; font-size: 38px; color: #f6e6ff; -unity-text-align: middle-left;
    -unity-text-outline-width: 1.2px; -unity-text-outline-color: #1a0d1f;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
}
/* 감성 문구: 모이라의 말과 같은 연보라 기울임 */
.vessel-line {
    margin-top: 6px; font-size: 23px; color: #e4d4f2; -unity-font-style: italic; -unity-text-align: middle-center; white-space: normal; max-width: 1100px;
    -unity-text-outline-width: 1px; -unity-text-outline-color: #1a1013; text-shadow: 0 2px 5px rgba(0, 0, 0, 0.9);
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
}

/* 22차 인벤토리 확장 알림 (GameUI.Stamp.cs). 움직임(위치, 크기, 투명도)은 코드가 매 프레임 정하고, 여기는 모양만.
   쪽지는 찢어진 종이 UI(panel_light 9-slice), 도장 자국은 Assets/UI/Paper/stamp_seal.png(데이터 hub.stampShow.mark). */
.stamp-note { position: absolute; left: 0; right: 0; top: 10%; align-items: center; }
.stamp-paper {
    width: 640px; height: 200px; padding: 0 150px 0 60px; justify-content: center; align-items: center;
    background-image: url("project://database/Assets/UI/Paper/panel_light.png");
    -unity-slice-left: 72; -unity-slice-right: 72; -unity-slice-top: 72; -unity-slice-bottom: 72; -unity-slice-scale: 0.7px;
}
.stamp-text {
    font-size: 42px; color: #2e2120; -unity-text-align: middle-center; white-space: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
}
/* 도장 자국: 쪽지 오른쪽 아래 모서리에 걸쳐 비스듬히 */
.stamp-mark {
    position: absolute; right: -26px; bottom: -40px; width: 190px; height: 190px; rotate: -14deg; opacity: 0;
    background-image: url("project://database/Assets/UI/Paper/stamp_seal.png"); -unity-background-scale-mode: scale-to-fit;
}
/* 찍히는 순간 둘레로 번지는 옅은 인주 기운 */
.stamp-ink {
    position: absolute; right: -86px; bottom: -100px; width: 310px; height: 310px; opacity: 0;
    background-image: url("project://database/Assets/Art/Generated/soft_disc.png"); -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(196, 40, 40, 0.45);
}
