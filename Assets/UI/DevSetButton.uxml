<!-- 개발자 모드: 세트 하나 (색 점 + "화염 +1"). DevTools 가 세트마다 복제한다. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Button name="set" class="dev-btn dev-set">
        <ui:VisualElement name="dot" class="dev-set-dot" picking-mode="Ignore" />
        <ui:Label name="label" picking-mode="Ignore" />
    </ui:Button>
</ui:UXML>
