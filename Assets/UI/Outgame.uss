/* 15차 아웃게임: 세트 해금 알림 띠, 다락 '시작 조각' 줄과 고르는 창. (Main.uxml 이 함께 불러온다)
   해금 알림 움직임: hidden 해제 → 다음 프레임 .show (띠가 튀어나오고 빛줄기가 지나가며 별이 터짐)
   → .fade (빛과 별이 사그라듦) → .leave (띠가 위로 사라짐). 시간은 GameUI.Outgame.cs 상수. */

/* ---------- 해금 알림 ---------- */
.unlock-notice {
    position: absolute; left: 0; right: 0; top: 560px;   /* 위쪽(top 60~200)은 일기 알림, 띠는 주인공 아래 */
    align-items: center;
}
.unlock-flash {
    position: absolute; width: 760px; height: 420px; top: -110px;
    background-image: url("project://database/Assets/vfx/fx_sigil.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0; scale: 0.4 0.4;
    transition-property: opacity, scale; transition-duration: 0.28s, 0.5s; transition-timing-function: ease-out, ease-out;
}
.unlock-ribbon {
    min-width: 620px; padding: 22px 90px 26px 90px;
    align-items: center;
    background-image: url("project://database/Assets/UI/Paper/button.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 44; -unity-slice-bottom: 44;
    -unity-slice-scale: 0.6px;
    -unity-background-image-tint-color: #ecdcbc;
    opacity: 0; scale: 0.55 0.55; rotate: -4deg; translate: 0 -40px;
    transition-property: opacity, scale, rotate, translate;
    transition-duration: 0.22s, 0.42s, 0.42s, 0.42s;
    transition-timing-function: ease-out, ease-out-back, ease-out-back, ease-out-back;
}
.unlock-shine-clip { position: absolute; left: 10px; right: 10px; top: 8px; bottom: 8px; overflow: hidden; }
.unlock-shine {
    position: absolute; top: -20px; bottom: -20px; width: 90px; left: -160px;
    background-color: rgba(255, 252, 236, 0.55);
    rotate: 18deg;
    transition-property: translate; transition-duration: 0.9s; transition-delay: 0.3s; transition-timing-function: ease-in-out;
}
.unlock-eyebrow { font-size: 18px; color: #5a3b32; letter-spacing: 2px; }
.unlock-name { font-size: 62px; color: #2e2120; margin-top: 2px; }
.unlock-text { font-size: 22px; color: #3b2a26; margin-top: 4px; -unity-text-align: middle-center; }
.unlock-foot { font-size: 17px; color: #5f4a3c; margin-top: 6px; }

.unlock-sparks { position: absolute; left: 0; right: 0; top: 0; height: 200px; }
.unlock-spark {
    position: absolute; font-size: 40px; color: #fff6dc;
    opacity: 0; scale: 0 0;
    transition-property: opacity, scale, rotate, translate;
    transition-duration: 0.25s, 0.35s, 0.9s, 0.9s;
    transition-timing-function: ease-out, ease-out-back, ease-out, ease-out;
}
.s1 { left: 50%; translate: -380px 30px; transition-delay: 0.10s; }
.s2 { left: 50%; translate: -300px -30px; transition-delay: 0.18s; font-size: 28px; }
.s3 { left: 50%; translate: -200px 120px; transition-delay: 0.26s; font-size: 24px; }
.s4 { left: 50%; translate: 330px -20px; transition-delay: 0.14s; }
.s5 { left: 50%; translate: 250px 110px; transition-delay: 0.22s; font-size: 30px; }
.s6 { left: 50%; translate: 400px 60px; transition-delay: 0.30s; font-size: 22px; }
.s7 { left: 50%; translate: -60px -60px; transition-delay: 0.34s; font-size: 26px; }
.s8 { left: 50%; translate: 120px -56px; transition-delay: 0.40s; font-size: 20px; }

.unlock-notice.show .unlock-flash { opacity: 0.85; scale: 1.15 1.15; }
.unlock-notice.show .unlock-ribbon { opacity: 1; scale: 1 1; rotate: -1deg; translate: 0 0; }
.unlock-notice.show .unlock-shine { translate: 900px 0; }
.unlock-notice.show .unlock-spark { opacity: 1; scale: 1 1; rotate: 45deg; }

.unlock-notice.fade .unlock-flash { opacity: 0; scale: 1.6 1.6; transition-duration: 0.8s, 0.8s; }
.unlock-notice.fade .unlock-spark { opacity: 0; scale: 1.4 1.4; rotate: 120deg; transition-delay: 0s; transition-duration: 0.6s, 0.6s, 0.6s, 0.6s; }

.unlock-notice.leave .unlock-ribbon { opacity: 0; translate: 0 -50px; scale: 0.9 0.9; transition-duration: 0.35s, 0.35s, 0.35s, 0.35s; transition-timing-function: ease-in, ease-in, ease-in, ease-in; }
.unlock-notice.leave .unlock-flash { opacity: 0; }

/* ---------------------------------------------------------------- 17차 다락 방, 모이라의 실궤 창 */
/* 실궤에서 연 창: 다락 방이 뒤에 비치도록 배경 그림을 걷고 옅은 그늘만 깐다 */
.room.attic.over-room { background-image: none; background-color: rgba(0, 0, 0, 0); }
.room.attic.over-room > .room-shade { background-color: rgba(14, 8, 18, 0.55); }
.attic-body { position: relative; }
/* 종이 오른쪽 위 파편 수 */
.attic-shards { position: absolute; top: 30px; right: 44px; margin-right: 0; }
.attic-grid { flex-wrap: wrap; justify-content: center; }
/* 방을 오갈 때 어두워짐 (FadeRoom 이 transition-duration 을 정함) */
.room-fade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(8, 5, 10); opacity: 0; transition-property: opacity; transition-timing-function: ease-in-out; }
.room-fade.on { opacity: 1; }

/* ---------------------------------------------------------------- 19차 모이라 창 */
/* 모이라 그림: 종이 왼쪽 밖에 앉아 있다 */
.attic-portrait { position: absolute; left: -390px; bottom: -40px; width: 380px; height: 400px; background-size: contain; background-position-y: bottom; -unity-background-scale-mode: scale-to-fit; }
.attic-line { -unity-font-style: italic; color: #c9b2e0; }

/* ---------------------------------------------------------------- 19차 판 위 줄 고르기 (GameUI.Board.cs) */
.board-pick { overflow: visible; }
.pick-band { position: absolute; }
/* 20차: 유리처럼 반투명한 띠 대신 종이. 강화한 줄 = 금물 든 양피지 띠, 올린 줄 = 양피지를 덮어 봄, 가장자리 띠와 손잡이 = 찢어진 양피지 쪽지 */
.pick-done, .pick-done-faint, .pick-hover {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Paper/panel_light.png");
    -unity-slice-left: 72; -unity-slice-right: 72; -unity-slice-top: 72; -unity-slice-bottom: 72;
    -unity-slice-scale: 0.22px;
}
.pick-done { -unity-background-image-tint-color: rgba(214, 168, 78, 0.62); }
.pick-done-faint { -unity-background-image-tint-color: rgba(214, 168, 78, 0.24); }
/* 마우스를 올린 줄 (board-ghost 위, 판 칸이 비치게 층이 반쯤 투명) */
.pick-hover { -unity-background-image-tint-color: rgb(236, 222, 192); }
.pick-hover.pick-taken { -unity-background-image-tint-color: rgb(196, 98, 84); }
/* 확장 가장자리 띠: 찢어진 양피지, 올리면 밝아지며 살짝 들림 */
.board-pick > .pick-strip {
    position: absolute; margin: 0; padding: 0; min-width: 0; min-height: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Paper/button.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 44; -unity-slice-bottom: 44;
    -unity-slice-scale: 0.34px;
    -unity-background-image-tint-color: rgb(122, 102, 82);
    border-width: 0; border-radius: 0;
    color: #1f1517; font-size: 40px; -unity-text-align: middle-center;
    transition-property: -unity-background-image-tint-color, color, translate; transition-duration: 0.12s;
}
.board-pick > .pick-strip:hover { -unity-background-image-tint-color: rgb(236, 220, 190); color: #1a1013; translate: 0 -2px; background-color: rgba(0, 0, 0, 0); }

/* ---------------------------------------------------------------- 19차 챙기기 판: 단추 진열 줄 */
.piece-row.offer { opacity: 0.82; border-width: 2px; border-color: rgba(61, 124, 112, 0.9); }
.piece-row.offer.short { opacity: 0.5; border-color: rgba(122, 93, 90, 0.9); }
.piece-row.offer.selected { opacity: 1; }
/* 진열 줄의 가격 꼬리표 (장착 중 꼬리표 자리, 청록 띠. 파편이 모자라면 흐린 갈색) */
.piece-row.offer .piece-state { display: flex; background-color: #2f6f63; -unity-text-outline-color: #12302a; }
.piece-row.offer.short .piece-state { background-color: #6a524f; }
/* 19차 칸 강화 손잡이: 판 왼쪽(가로 줄), 위(세로 줄). 이미 강화한 줄은 금빛 테두리, 올리면 밝아짐 */
.board-pick > .pick-strip.pick-handle { font-size: 15px; -unity-slice-scale: 0.22px; -unity-background-image-tint-color: rgb(122, 102, 82); color: #2a1d1a; }
.board-pick > .pick-strip.pick-handle:hover { -unity-background-image-tint-color: rgb(236, 220, 190); color: #1a1013; }
/* 21차: 이미 강화한 줄의 손잡이는 금빛 대신 흐리게 (줄 위 칸에는 "+N" 숫자) */
.board-pick > .pick-strip.pick-handle.pick-taken { -unity-background-image-tint-color: rgb(74, 60, 52); color: #8a7462; }

/* 20차 칸 강화, 확장 연출 (GameUI.Board.cs PlayLineGrow). 색, 크기, 위치는 데이터(hub.lineGrow)와 코드가 정한다 */
.grow-thread { position: absolute; border-radius: 6px; }
.grow-glow { position: absolute; background-image: url("project://database/Assets/Art/Generated/soft_disc.png"); -unity-background-scale-mode: stretch-to-fill; }
