/* 욕망의 탑 UI — 찢어진 종이 + 거친 검은 잉크 (DST식, 1920×1080 기준).
   종이 조각: Assets/UI/Paper/*.png (tools/bake_ui_paper.py). 9-slice 는 -unity-slice-* 로 잡고
   -unity-slice-scale 로 테두리 굵기를 맞춘다. 색은 tint(-unity-background-image-tint-color)로 물들인다.
   위 가운데 줄: 타이머(top 14) 또는 보스 HUD(top 10, 약 135px) → 라운드 띠(top 146).
   팔레트: 잉크 #1a1013 · 어두운 종이 글자 #eadcc4 / 흐린 #a8968a · 양피지 글자 #2e2120 / 흐린 #5f4a3c
           금 #d6b06e · 포도주 #7d2f3e · 먼지 분홍 #d99aae · 청록 #8fbfb2 */
:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    font-size: 24px;
    color: #eadcc4;
}

.root { flex-grow: 1; }
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hidden { display: none; }
.serif { -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.title-font { -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.small-font { -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
Label { margin: 0; padding: 0; white-space: normal; }

/* ---------- 종이 조각 (공통) ---------- */
.paper-dark, .panel {
    background-image: url("project://database/Assets/UI/Paper/panel_dark.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64;
    -unity-slice-scale: 0.6px;
    background-color: rgba(0, 0, 0, 0);
}
.paper-light {
    background-image: url("project://database/Assets/UI/Paper/panel_light.png");
    -unity-slice-left: 72; -unity-slice-right: 72; -unity-slice-top: 72; -unity-slice-bottom: 72;
    -unity-slice-scale: 0.8px;
    background-color: rgba(0, 0, 0, 0);
}

/* ---------- 버튼: 찢어진 양피지 띠 ---------- */
Button {
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    font-size: 24px;
    border-radius: 0;
    border-width: 0;
    padding: 10px 36px 12px 36px;
    min-height: 54px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Paper/button.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 44; -unity-slice-bottom: 44;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: #ddcdb0;
    color: #2e2120;
    transition-property: -unity-background-image-tint-color, scale, translate;
    transition-duration: 0.12s;
}
Button:hover { background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: #ffffff; color: #1a1013; translate: 0 -2px; }
Button:active { scale: 0.97 0.97; translate: 0 1px; }
Button:focus { background-color: rgba(0, 0, 0, 0); }
Button:disabled { opacity: 0.5; }
/* 주 버튼: 포도주 물든 종이 */
.primary { -unity-background-image-tint-color: #b5596c; color: #fbeedd; -unity-text-outline-width: 1px; -unity-text-outline-color: #3b1219; }
.primary:hover { -unity-background-image-tint-color: #d07386; color: #ffffff; }
/* 둥근 밀랍 인장 버튼 (일시 정지·소리) */
.icon-button {
    min-height: 60px; width: 60px; height: 60px; padding: 0 0 2px 0; font-size: 24px;
    background-image: url("project://database/Assets/UI/Paper/seal.png");
    -unity-slice-left: 0; -unity-slice-right: 0; -unity-slice-top: 0; -unity-slice-bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #d9c4c4;
    color: #f6dfd0; -unity-text-outline-width: 1px; -unity-text-outline-color: #2a0c12; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.icon-button:hover { -unity-background-image-tint-color: #ffffff; color: #ffffff; }
/* 24차: 소리 꺼짐 = 음표 위 빗금, 음표는 살짝 흐리게 (GameUI.SetSoundMuted) */
.sound-slash {
    position: absolute; left: 50%; top: 50%; width: 5px; height: 36px; margin-left: -2.5px; margin-top: -19px;
    background-color: #f6dfd0; border-width: 1px; border-color: #2a0c12; border-radius: 2px;
    rotate: 45deg; display: none;
}
.sound-button.muted { color: #cdb8ad; }
.sound-button.muted .sound-slash { display: flex; }
.sound-button.muted:hover .sound-slash { background-color: #ffffff; }
.actions { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 26px; }
.actions > Button { margin-right: 14px; margin-bottom: 6px; }

.eyebrow { color: #d6b06e; font-size: 15px; margin-bottom: 8px; letter-spacing: 3px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.panel { padding: 30px 34px; }

/* 작은 게이지: 거친 잉크 틀(meter_frame) 안에 종이 결로 물든 채움 */
.meter { background-color: #1e1418; overflow: hidden; }
.meter-fill {
    height: 100%; width: 0;
    background-image: url("project://database/Assets/UI/Paper/grain.png");
    background-size: 256px 128px; background-repeat: repeat repeat;
    -unity-background-image-tint-color: #d6b06e;
    border-right-width: 2px; border-color: rgba(20, 10, 14, 0.75);
}
.meter-fill.health { -unity-background-image-tint-color: #c4566c; }
.meter-fill.desire { -unity-background-image-tint-color: #9466a6; }
.meter-fill.boss { -unity-background-image-tint-color: #b23a4f; }
.bar-frame { height: 30px; }
.bar-track { position: absolute; left: 9px; right: 10px; top: 7px; bottom: 8px; }
.bar-ink {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-image: url("project://database/Assets/UI/Paper/meter_frame.png");
    -unity-slice-left: 56; -unity-slice-right: 56; -unity-slice-top: 40; -unity-slice-bottom: 40;
    -unity-slice-scale: 0.26px;
    -unity-background-image-tint-color: #8a7560;
}

/* ---------- 전투 HUD ---------- */
.hud { padding: 22px 26px; }
.status { position: absolute; left: 18px; top: 14px; width: 400px; }
.route { position: absolute; right: 96px; top: 14px; width: 350px; }
.section-head { flex-direction: row; align-items: center; margin-bottom: 14px; }
.section-head .mark { color: #d6b06e; margin-right: 8px; }
.section-head .heading { flex-grow: 1; font-size: 24px; color: #f0e2c8; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); -unity-text-outline-width: 1px; -unity-text-outline-color: #1a1013; }
/* 작은 꼬리표: 양피지 쪽지 */
.tag {
    color: #2e2120; font-size: 15px; padding: 4px 14px 5px 14px;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    background-image: url("project://database/Assets/UI/Paper/button.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 44; -unity-slice-bottom: 44;
    -unity-slice-scale: 0.28px;
    -unity-background-image-tint-color: #e2cfa8;
}
.stat { margin-bottom: 10px; }
.stat-label { flex-direction: row; align-items: center; margin-bottom: 2px; color: #d8c8b4; font-size: 15px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.stat-label .icon { width: 30px; height: 30px; margin-right: 8px; -unity-background-scale-mode: scale-to-fit; }
.stat-label .value { margin-left: auto; color: #f0e2c8; }
.yarn-pips { flex-direction: row; height: 12px; margin: 2px 4px 0 4px; }
.yarn-pip { flex-grow: 1; margin-right: 5px; background-color: #241a1e; border-width: 2px; border-color: #120a0d; border-radius: 2px; overflow: hidden; }
.yarn-pip.full { background-color: #7fb0a5; border-color: #0f1a18; }
.yarn-wind { height: 100%; background-color: #4c7d76; width: 0; }
.thread-status { flex-direction: row; justify-content: space-between; margin: 6px 4px 0 4px; color: #a8968a; font-size: 15px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.dash-icon { background-image: url("project://database/Assets/sprites/stat_dash.png"); }
.dash-pips { flex-direction: row; height: 14px; margin: 2px 4px 0 4px; }
.dash-pip { flex-grow: 1; margin-right: 6px; background-color: #241a1e; border-radius: 2px; border-width: 2px; border-color: #120a0d; overflow: hidden; }
.dash-pip.full { background-color: #8fc3d6; border-color: #0e1a20; }
.dash-fill { height: 100%; width: 0; background-color: #4f7f93; }
.status-bottom { flex-direction: row; border-top-width: 2px; border-color: rgba(10, 5, 8, 0.6); margin-top: 12px; padding-top: 12px; }
.status-bottom > VisualElement { flex-grow: 1; flex-direction: row; align-items: center; color: #a8968a; font-size: 15px; margin-right: 12px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.status-bottom .icon { width: 28px; height: 28px; margin-right: 6px; -unity-background-scale-mode: scale-to-fit; }
.status-bottom .value { margin-left: auto; color: #d6b06e; }
.round { flex-direction: row; align-items: center; color: #a8968a; padding: 6px 12px; font-size: 15px; margin-bottom: 4px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.round .num { width: 28px; height: 28px; border-width: 2px; border-color: #120a0d; background-color: #241a1e; border-radius: 3px; -unity-text-align: middle-center; margin-right: 12px; color: #a8968a; }
.round.current {
    color: #2e2120;
    background-image: url("project://database/Assets/UI/Paper/button.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 44; -unity-slice-bottom: 44;
    -unity-slice-scale: 0.36px;
    -unity-background-image-tint-color: #e2cfa8;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
}
.round.current .num { border-color: #1a1013; background-color: #7d2f3e; color: #fbeedd; }
.round.done { color: #8fbfb2; }
.round.done .num { color: #8fbfb2; }
.route-info { color: #b8a696; margin: 10px 4px 0 4px; font-size: 15px; min-height: 22px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.pause-button { position: absolute; right: 22px; top: 18px; }

/* 화면 위 가운데 줄: 생존 타이머 또는 보스 HUD(위) → 라운드 띠(그 아래, top 146). */
.banner { position: absolute; top: 146px; left: 0; right: 0; align-items: center; }
.banner > Label {
    padding: 12px 46px 14px 46px; color: #2e2120; font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    background-image: url("project://database/Assets/UI/Paper/button.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 44; -unity-slice-bottom: 44;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: #ecdcbc;
}
.round-timer { position: absolute; top: 14px; left: 0; right: 0; align-items: center; }
.round-timer > Label {
    min-width: 190px; padding: 12px 36px 16px 36px; -unity-text-align: middle-center;
    font-size: 45px; color: #f3e2c8; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    -unity-text-outline-width: 1px; -unity-text-outline-color: #1a1013;
    background-image: url("project://database/Assets/UI/Paper/panel_dark.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64;
    -unity-slice-scale: 0.42px;
}
.round-timer.urgent > Label { color: #ff8f8f; -unity-background-image-tint-color: #ffb4b4; }
.hint-bar { position: absolute; bottom: 100px; left: 0; right: 0; align-items: center; }
.hint-bar > Label {
    padding: 12px 40px 14px 40px; color: #2e2120; font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    background-image: url("project://database/Assets/UI/Paper/button.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 44; -unity-slice-bottom: 44;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: #ecdcbc;
}
.choice .piece-icon { width: 40px; height: 40px; margin-bottom: 8px; }

/* 보스 HUD: 위 가운데, 큼 */
.boss-hud { position: absolute; top: 10px; left: 0; right: 0; align-items: center; }
.boss-title {
    flex-direction: row; align-items: center; justify-content: center; margin-bottom: -6px; padding: 6px 34px 10px 14px;
    background-image: url("project://database/Assets/UI/Paper/panel_dark.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64;
    -unity-slice-scale: 0.4px;
}
.boss-seal {
    width: 50px; height: 50px; margin-right: 10px; align-items: center; justify-content: center;
    background-image: url("project://database/Assets/UI/Paper/seal.png"); -unity-background-scale-mode: scale-to-fit;
}
.boss-seal > Label { color: #f6dfd0; font-size: 24px; -unity-text-outline-width: 1px; -unity-text-outline-color: #2a0c12; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.boss-name {
    font-size: 30px; color: #f3e2c8; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    -unity-text-outline-width: 2px; -unity-text-outline-color: #1a1013;
    text-shadow: 3px 3px 0px rgba(10, 4, 6, 0.7);
}
.boss-frame { width: 700px; height: 70px; }
.boss-frame .bar-track { left: 22px; right: 23px; top: 17px; bottom: 17px; }
.boss-frame .bar-ink { -unity-slice-scale: 0.6px; -unity-background-image-tint-color: #a08a70; }
.boss-frame .meter-fill { border-right-width: 3px; }

.controls-hint { position: absolute; left: 26px; bottom: 52px; flex-direction: row; color: #cbb9a6; font-size: 15px; text-shadow: 2px 2px 0px rgba(10, 4, 6, 0.85); -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.controls-hint > Label { margin-right: 22px; }
.kbd { background-color: #e2cfa8; border-width: 2px; border-bottom-width: 4px; border-color: #1a1013; border-radius: 3px; color: #2e2120; padding: 3px 8px; margin-right: 6px; font-size: 15px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }

/* ---------- world labels ---------- */
.world-label {
    position: absolute;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    -unity-text-align: middle-center;
    white-space: nowrap;
    translate: -50% -50%;
    -unity-text-outline-color: #1c0e21;
}
/* 23차 결박 당기기의 라틴어 죄종 글자: Cinzel Black SDF 로마 비문체. 크기, 색, 외곽은 GameUI.Inscription.cs 가 데이터(db.bind.title)로 매 프레임 넣는다 */
.world-inscription { position: absolute; flex-direction: row; align-items: center; translate: -50% -50%; }
.inscription-stack { margin: 0 10px; }
.inscription-text {
    -unity-font-definition: url("project://database/Assets/Fonts/Cinzel/Cinzel_SDF.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: nowrap;
    padding: 0; margin: 0;
}
.inscription-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.inscription-aura { position: absolute; left: -35%; right: -35%; top: -85%; bottom: -85%; background-image: url("project://database/Assets/Art/Generated/soft_disc.png"); -unity-background-scale-mode: stretch-to-fill; }
.inscription-upper { position: absolute; left: 0; right: 0; top: 0; height: 50%; overflow: hidden; }
.inscription-hi { position: absolute; left: 0; right: 0; top: 0; height: 200%; }
.inscription-rule { border-width: 1px; border-radius: 2px; }

/* ---------- lobby ---------- */
.lobby { background-image: url("project://database/Assets/ref/image-1-1.jpeg"); -unity-background-scale-mode: scale-and-crop; background-color: #241a1e; }
.lobby-shade { position: absolute; left: 0; top: 0; bottom: 0; right: 0; background-image: url("project://database/Assets/Art/Generated/lobby_shade.png"); -unity-background-scale-mode: stretch-to-fill; }
.topbar {
    position: absolute; left: -30px; right: -30px; top: -18px; height: 124px; flex-direction: row; align-items: center; padding: 18px 86px 0 86px;
    background-image: url("project://database/Assets/UI/Paper/panel_dark.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64;
    -unity-slice-scale: 0.6px;
}
.brand { flex-direction: row; align-items: center; flex-grow: 1; }
.brand-icon { width: 62px; height: 62px; margin-right: 18px; align-items: center; justify-content: center; background-image: url("project://database/Assets/UI/Paper/seal.png"); -unity-background-scale-mode: scale-to-fit; }
.brand-icon > VisualElement { width: 34px; height: 34px; background-image: url("project://database/Assets/sprites/icon_needle.png"); -unity-background-scale-mode: scale-to-fit; }
.brand-name { font-size: 30px; color: #f3e2c8; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); -unity-text-outline-width: 1px; -unity-text-outline-color: #1a1013; }
.brand-sub { color: #d6b06e; font-size: 12px; letter-spacing: 4px; margin-top: 6px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.shards { flex-direction: row; align-items: center; color: #ffffff; margin-right: 22px; font-size: 26px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
/* 20차: 파편 수는 흰 글자 + 검은 테두리 (어두운 방, 양피지 어디서나 읽히게) */
.shards > Label { color: #ffffff; -unity-text-outline-width: 1.8px; -unity-text-outline-color: #000000; text-shadow: 1px 2px 2px rgba(0, 0, 0, 0.55); }
.shards > VisualElement { width: 32px; height: 32px; margin-right: 8px; background-image: url("project://database/Assets/sprites/icon_shard.png"); -unity-background-scale-mode: scale-to-fit; }
.welcome-copy {
    position: absolute; left: 96px; top: 190px; width: 820px; padding: 52px 64px 50px 64px;
    background-image: url("project://database/Assets/UI/Paper/panel_dark.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64;
    -unity-slice-scale: 0.9px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.94);
}
.chapter { flex-direction: row; align-items: center; color: #d6b06e; letter-spacing: 6px; font-size: 15px; margin-bottom: 14px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.chapter > VisualElement { width: 26px; height: 2px; background-color: #8a6a48; margin: 0 12px; }
.welcome-title { font-size: 60px; color: #f3e2c8; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); -unity-text-outline-width: 3px; -unity-text-outline-color: #1a1013; text-shadow: 5px 5px 0px rgba(10, 4, 6, 0.75); }
.welcome-text { color: #dccbb6; font-size: 24px; margin: 18px 0 32px 0; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.menu { flex-direction: column; align-items: flex-start; }
.menu > Button { min-width: 330px; margin-bottom: 10px; -unity-text-align: middle-left; padding-left: 42px; }
.start-button { font-size: 24px; min-height: 66px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.hint { color: #b8a696; font-size: 15px; margin-top: 10px; flex-direction: row; align-items: center; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.record { color: #b8a696; font-size: 15px; margin-top: 24px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.record-value { color: #d6b06e; }
.corner { position: absolute; width: 34px; height: 34px; border-color: rgba(26, 16, 19, 0.85); }
.corner.tl { left: 18px; top: 122px; border-left-width: 3px; border-top-width: 3px; }
.corner.tr { right: 18px; top: 122px; border-right-width: 3px; border-top-width: 3px; }
.corner.bl { left: 18px; bottom: 18px; border-left-width: 3px; border-bottom-width: 3px; }
.corner.br { right: 18px; bottom: 18px; border-right-width: 3px; border-bottom-width: 3px; }
.lobby-controls {
    position: absolute; left: 96px; bottom: 40px; flex-direction: row; align-items: center; color: #5f4a3c; font-size: 15px; padding: 18px 40px 20px 40px;
    background-image: url("project://database/Assets/UI/Paper/button.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 44; -unity-slice-bottom: 44;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: #e2cfa8; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.lobby-controls > Label { margin-right: 24px; }
.lobby-controls .control-title { color: #7d2f3e; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }

/* ---------- rooms (재봉 상자 · 다락 · 결과): 어두운 종이 판 ---------- */
.room { align-items: center; justify-content: center; background-color: #1c1417; }
.room.attic { background-image: url("project://database/Assets/ref/image-23-1.jpeg"); -unity-background-scale-mode: scale-and-crop; }
.room-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(20, 12, 15, 0.8); }
.room-body {
    width: 1100px; padding: 52px 64px;
    background-image: url("project://database/Assets/UI/Paper/panel_dark.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64;
    -unity-slice-scale: 0.9px;
}
.room-title { font-size: 45px; color: #f3e2c8; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); -unity-text-outline-width: 2px; -unity-text-outline-color: #1a1013; text-shadow: 3px 3px 0px rgba(10, 4, 6, 0.7); }
.room-text { color: #c9b8a6; margin-top: 10px; }
/* ---------- 재봉 상자 (8차): 세트 패널 · 판(칸 + 조각 그림 층 + 반투명 미리보기 층) · 목록 · 정보 창 ---------- */
.sewing-body { width: 1520px; }
.inventory-layout { flex-direction: row; align-items: flex-start; margin-top: 20px; }
.board-wrap { position: relative; margin: 0 26px; flex-shrink: 0; }
.board { flex-direction: row; flex-wrap: wrap; background-color: #160e11; padding: 0; }
.board-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.board-ghost { opacity: 0.55; }
.board-ghost.invalid { opacity: 0.7; }
.board-ghost.paper { opacity: 0.76; }   /* 20차 강화 줄 고르기: 양피지 띠 */
.cell { margin: 2px; padding: 0; min-height: 0; border-radius: 0; border-width: 0; background-image: url("project://database/Assets/UI/Puzzle/slot_empty.png"); -unity-slice-left: 0; -unity-slice-right: 0; -unity-slice-top: 0; -unity-slice-bottom: 0; -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: #4e3e46; background-color: rgba(0, 0, 0, 0); color: #241624; font-size: 15px; translate: 0 0; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.cell:hover { background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: #7a6470; translate: 0 0; }
/* 21차: 강화한 칸은 색 대신 오른쪽 아래 "+N" 숫자 (위쪽은 세트 이름 꼬리표 자리) (GameUI.Board.cs DrawBadges) */
.cell-badge {
    position: absolute; margin: 0; padding: 0 4px 2px 0;
    -unity-text-align: lower-right; white-space: nowrap;
    color: #fff3c4; font-size: 14px;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    -unity-text-outline-width: 1.3px; -unity-text-outline-color: #120a0c;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.85);
}
.cell.filled { -unity-background-image-tint-color: #2c2228; }
.cell.preview { -unity-background-image-tint-color: #8a7480; }
/* 조각 한 칸: 종이(등급 색 tint) 위에 잉크 테두리, 바깥 변을 따라 바늘땀. 마스크 그림은 Puzzle.uss 의 .k{n} */
.piece-tile { position: absolute; }
.tile-paper, .tile-edge { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.tile-paper { overflow: hidden; }
.tile-edge { -unity-background-image-tint-color: #1a1013; }
.piece-tile.rank-3 .tile-edge { -unity-background-image-tint-color: #4a2e0c; }
.piece-tile.rank-4 .tile-edge { -unity-background-image-tint-color: #f1d27a; }
.piece-tile.selected .tile-edge { -unity-background-image-tint-color: #fff4dc; }
.seam { position: absolute; overflow: hidden; }
.thread { position: absolute; left: 0; top: 0; -unity-background-image-tint-color: #6b5446; }
.thread-h { background-image: url("project://database/Assets/UI/Puzzle/stitch_h.png"); background-repeat: repeat-x; background-size: 18px 100%; }
.thread-v { background-image: url("project://database/Assets/UI/Puzzle/stitch_v.png"); background-repeat: repeat-y; background-size: 100% 18px; }
.rank-2 .thread { -unity-background-image-tint-color: #24527d; }
.rank-3 .thread { -unity-background-image-tint-color: #7e5208; }
.rank-4 .thread { -unity-background-image-tint-color: #f6dc8a; }
/* 아이템 슬롯: 조각의 칸마다 종이에 눌린 네모 홈(slot_frame) + 모서리 십자 땀(slot_corners, 등급 실 색). tools/bake_puzzle_tiles.py */
.tile-slot { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: url("project://database/Assets/UI/Puzzle/slot_frame.png"); -unity-background-scale-mode: stretch-to-fill; }
.slot-corners { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: url("project://database/Assets/UI/Puzzle/slot_corners.png"); -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: #6b5446; }
.rank-2 .slot-corners { -unity-background-image-tint-color: #24527d; }
.rank-3 .slot-corners { -unity-background-image-tint-color: #7e5208; }
.rank-4 .slot-corners { -unity-background-image-tint-color: #f6dc8a; }
.tile-knot { position: absolute; left: 7%; top: 7%; width: 14%; height: 14%; border-radius: 50%; border-width: 2px; border-color: #1a1013; }
.tile-ornament { position: absolute; right: 12%; bottom: 10%; width: 30%; height: 30%; background-image: url("project://database/Assets/UI/Puzzle/ornament.png"); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: #b8862b; }
.rank-4 .tile-ornament { -unity-background-image-tint-color: #f6e3a1; }
/* 조각 무게 중심의 아이템 아이콘 (코드가 위치·크기 지정) */
.piece-mark { position: absolute; -unity-background-scale-mode: scale-to-fit; }
/* 서로 다른 조각이 맞닿은 경계: 어두운 홈 + 건너 잇는 땀 두 개 (join_h/v) */
/* 바깥(piece-join)이 잘라 내는 창, 안(join-art)이 그림: 바느질할 때 바깥 길이만 늘려 땀이 차례로 드러난다 */
.piece-join { position: absolute; overflow: hidden; }
.join-art { position: absolute; left: 0; top: 0; -unity-background-scale-mode: stretch-to-fill; }
.piece-join-v .join-art { background-image: url("project://database/Assets/UI/Puzzle/join_v.png"); }
.piece-join-h .join-art { background-image: url("project://database/Assets/UI/Puzzle/join_h.png"); }
/* 장착 매듭 불티 · 끄는 중인 반투명 조각(자식 조각 칸은 코드가 배치) · 끄는 동안 놓일 자리 미리보기는 더 옅게 */
.sew-spark { position: absolute; width: 22px; height: 22px; translate: -11px -11px; background-image: url("project://database/Assets/UI/Puzzle/sparkle.png"); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: #fff1c0; display: none; }
.drag-piece { position: absolute; left: 0; top: 0; width: 0; height: 0; opacity: 0.62; }
.board-ghost.drag { opacity: 0.45; }
.board-ghost.drag.invalid { opacity: 0.6; }
.tile-sparkle { position: absolute; right: 4%; top: 4%; width: 30%; height: 30%; background-image: url("project://database/Assets/UI/Puzzle/sparkle.png"); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: #fff7d6; }
.tile-shine { position: absolute; top: 0; bottom: 0; width: 60%; background-image: url("project://database/Assets/UI/Puzzle/shine.png"); -unity-background-scale-mode: stretch-to-fill; opacity: 0.55; }
.sew-needle { position: absolute; width: 84px; height: 21px; translate: -84px -10px; transform-origin: 100% 50%; background-image: url("project://database/Assets/UI/Puzzle/needle.png"); -unity-background-scale-mode: stretch-to-fill; }
/* 목록: 왼쪽 아이콘 · 퍼즐 모양 · 오른쪽 끝 이름. 한 줄 높이 = 판 한 칸 (코드가 맞춤) */
.stash { flex-grow: 0; flex-shrink: 0; width: 440px; }
/* 21차 목록 정렬: 오른쪽 위 찢어진 양피지 버튼 + 아래로 펼쳐지는 기준 목록 (목록 위에 겹침) */
.stash-col { position: relative; flex-direction: column; flex-shrink: 0; }
.stash-head { flex-direction: row; justify-content: flex-end; height: 46px; margin-bottom: 8px; }
.stash-sort, .sort-option {
    margin: 0; padding: 4px 22px 6px 22px; min-width: 0; border-width: 0; border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Paper/button.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 44; -unity-slice-bottom: 44; -unity-slice-scale: 0.3px;
    -unity-background-image-tint-color: rgb(122, 102, 82);
    color: #1f1517; font-size: 17px; -unity-text-align: middle-center; letter-spacing: 2px;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
}
.stash-sort { width: 160px; height: 46px; color: #1a1013; }
.stash-sort:hover, .sort-option:hover { -unity-background-image-tint-color: rgb(236, 220, 190); background-color: rgba(0, 0, 0, 0); }
.stash-sort-menu { position: absolute; top: 52px; right: 0; width: 160px; flex-direction: column; }
.sort-option { height: 42px; margin-top: 6px; }
.sort-option.current { -unity-background-image-tint-color: rgb(214, 168, 78); }
.piece-row {
    flex-direction: row; align-items: center; min-height: 0; padding: 4px 26px 4px 14px; margin-bottom: 4px;
    -unity-slice-scale: 0.5px; -unity-background-image-tint-color: #d9c7a8; color: #2e2120;
}
.piece-row:hover { translate: -4px 0; }
.piece-row.selected { translate: -10px 0; }
.piece-item-icon { width: 76px; height: 76px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.piece-shape-col { flex-shrink: 0; margin-left: 16px; align-items: center; justify-content: center; }
.piece-shape-slot { position: relative; flex-shrink: 0; }
/* 판 위 조각의 세트 이름 꼬리표 (조각 맨 윗줄 가운데, 코드가 위치·색 지정) */
.board-set-row { position: absolute; flex-direction: row; justify-content: center; align-items: flex-start; }
.board-set-tag { font-size: 15px; padding: 0 6px 1px 6px; background-color: rgba(26, 16, 19, 0.82); border-radius: 3px; -unity-text-align: middle-center; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.piece-name-box { flex-grow: 1; align-items: flex-end; justify-content: center; }
/* 세트 이름 (이름 위, 세트 색 글씨 + 잉크 외곽선, 코드가 칠함) */
/* 목록 줄의 세트 이름: 어두운 잉크 꼬리표 위 세트 색 글씨 (세트 색 종이와 섞이지 않게) */
.piece-set { font-size: 15px; -unity-text-align: middle-center; margin-bottom: 4px; padding: 1px 8px 2px 8px; background-color: rgba(26, 16, 19, 0.82); border-radius: 3px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.tip-set-name { font-size: 15px; -unity-text-outline-width: 2px; -unity-text-outline-color: #1a1013; margin-top: 2px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
/* 이름 색 = 등급 색(코드가 칠함). 세트 색 종이 위에서 읽히게 잉크 외곽선 */
.piece-name { font-size: 24px; color: #1a1013; -unity-text-outline-width: 2px; -unity-text-outline-color: #1a1013; -unity-text-align: middle-right; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
/* 장착 중 꼬리표: 포도주색 띠 + 밝은 글씨, 장착한 줄에서만 */
.piece-state { display: none; margin-top: 4px; padding: 2px 10px 3px 10px; font-size: 15px; color: #fff4e4; background-color: #7d2f3e; border-width: 2px; border-color: #1a1013; border-radius: 3px; -unity-text-outline-width: 1px; -unity-text-outline-color: #3b1219; -unity-text-align: middle-center; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.piece-row.equipped .piece-state { display: flex; }
/* 23차: 장착 중 줄 = 금빛 테두리 + 안쪽 금실 바느질 + 바깥 은은한 빛 (PieceButton.uxml equip-frame) */
.piece-equip { display: none; position: absolute; left: 3px; top: 3px; right: 3px; bottom: 3px; border-width: 3px; border-radius: 5px; border-color: #e7b84e; }
.piece-row.equipped .piece-equip { display: flex; }
.piece-equip-glow { position: absolute; left: -7px; top: -7px; right: -7px; bottom: -7px; border-width: 4px; border-radius: 9px; border-color: rgba(255, 214, 110, 0.38); }
.piece-equip-stitch { position: absolute; -unity-background-image-tint-color: #f6dc8a; }
.piece-equip-stitch.top, .piece-equip-stitch.bottom { left: 8px; right: 8px; height: 6px; background-image: url("project://database/Assets/UI/Puzzle/stitch_h.png"); background-repeat: repeat-x; background-size: 16px 100%; }
.piece-equip-stitch.top { top: 3px; }
.piece-equip-stitch.bottom { bottom: 3px; }
.piece-equip-stitch.left, .piece-equip-stitch.right { top: 8px; bottom: 8px; width: 6px; background-image: url("project://database/Assets/UI/Puzzle/stitch_v.png"); background-repeat: repeat-y; background-size: 100% 16px; }
.piece-equip-stitch.left { left: 3px; }
.piece-equip-stitch.right { right: 3px; }
/* 등급 꼬리표: 등급 색 바탕(코드가 칠함), 장착 중 아래 */
.piece-rank { margin-top: 4px; padding: 2px 10px 3px 10px; font-size: 15px; border-width: 2px; border-color: #1a1013; border-radius: 3px; -unity-text-align: middle-center; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.piece-dot { position: absolute; -unity-background-scale-mode: stretch-to-fill; border-color: rgba(26, 16, 19, 0.7); }
/* 세트 효과 패널 (22차): 판에 가진 세트만. 이름(죄종 색 글씨) (개수) + 메인/부가 꼬리표, 아래 켜진 효과 짧게(줄바꿈).
   첫 단계에 못 미친 세트는 회색 한 줄. 단계별 긴 효과는 마우스 올림 창(.set-tip)에 */
.set-panel { width: 330px; flex-shrink: 0; padding: 18px 18px 8px 18px; background-color: rgba(10, 5, 8, 0.5); border-width: 2px; border-color: #3a2a2e; border-radius: 4px; }
.set-panel-title { font-size: 24px; color: #d6b06e; margin-bottom: 12px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.set-list { max-height: 640px; }
.set-empty { font-size: 15px; color: #8a7d74; white-space: normal; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.set-entry { margin-bottom: 8px; padding: 6px 10px 7px 10px; border-left-width: 4px; border-color: rgba(0, 0, 0, 0); border-radius: 2px; }
.set-entry.active { background-color: rgba(255, 236, 210, 0.07); }
.set-entry:hover { background-color: rgba(255, 236, 210, 0.13); }
.set-head { flex-direction: row; align-items: center; }
.set-name { font-size: 24px; -unity-text-outline-width: 1px; -unity-text-outline-color: #1a1013; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.set-count { flex-grow: 1; margin-left: 6px; font-size: 24px; color: #eadcc4; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.set-entry.off .set-count { color: #7c716b; }
.set-role { font-size: 15px; padding: 1px 7px 2px 7px; border-radius: 3px; color: #1a1013; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.set-brief { font-size: 15px; color: #f1e6d4; margin-top: 2px; white-space: normal; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
/* 세트 정보 창: 어두운 종이, 이름은 죄종 색, 단계 줄은 달성 흰색 / 못 달성 회색 (코드가 .done 을 붙임) */
.set-tip {
    position: absolute; width: 540px; padding: 30px 34px 36px 34px;
    background-image: url("project://database/Assets/UI/Paper/panel_dark.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64; -unity-slice-scale: 0.6px;
}
.set-tip-head { flex-direction: row; align-items: flex-end; }
.set-tip-name { font-size: 30px; -unity-text-outline-width: 2px; -unity-text-outline-color: #1a1013; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.set-tip-count { flex-grow: 1; margin-left: 10px; margin-bottom: 3px; font-size: 15px; color: #b3a497; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.set-tip-role { font-size: 15px; margin-top: 2px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.set-tip-desc { font-size: 15px; color: #cdbca8; margin-top: 8px; padding-bottom: 10px; border-bottom-width: 1px; border-color: rgba(234, 220, 196, 0.25); white-space: normal; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.set-tip-tiers { margin-top: 8px; }
.set-tip-tier { flex-direction: row; align-items: flex-start; margin-top: 5px; }
.set-tip-need { width: 38px; flex-shrink: 0; font-size: 18px; color: #857c76; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.set-tip-effect { flex-grow: 1; flex-shrink: 1; font-size: 18px; color: #857c76; white-space: normal; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.set-tip-tier.done .set-tip-need, .set-tip-tier.done .set-tip-effect { color: #ffffff; -unity-text-outline-width: 1px; -unity-text-outline-color: #1a1013; }
/* 아이템 정보 창: 양피지(등급 색으로 살짝 물듦), 마우스를 따라다님 */
.piece-tip {
    position: absolute; width: 440px; padding: 24px 28px;
    background-image: url("project://database/Assets/UI/Paper/panel_light.png");
    -unity-slice-left: 72; -unity-slice-right: 72; -unity-slice-top: 72; -unity-slice-bottom: 72; -unity-slice-scale: 0.6px;
    color: #2e2120;
}
.tip-head { flex-direction: row; align-items: center; }
.tip-icon { width: 64px; height: 64px; flex-shrink: 0; margin-right: 12px; -unity-background-scale-mode: scale-to-fit; }
.tip-title { flex-grow: 1; flex-shrink: 1; }
.tip-name { font-size: 30px; color: #1a1013; -unity-text-outline-width: 2px; -unity-text-outline-color: #1a1013; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.tip-rank { font-size: 15px; margin-top: 2px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.tip-shape { position: relative; flex-shrink: 0; margin-left: 10px; }
.tip-line { font-size: 15px; color: #4a3a30; margin-top: 10px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
/* 고유 효과 (유니크·레전더리): 금빛 띠 위 잉크 글자 */
.tip-unique { font-size: 15px; color: #2a1608; margin-top: 8px; padding: 4px 8px; background-color: rgba(214, 160, 60, 0.45); border-left-width: 3px; border-color: #8a5a14; white-space: normal; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.tip-effect { font-size: 24px; color: #7d2f3e; margin-top: 8px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.tip-set-row { flex-direction: row; align-items: center; margin-top: 8px; }
.tip-set-row > .tip-line { margin-top: 0; flex-shrink: 1; }
.tip-knot { width: 14px; height: 14px; flex-shrink: 0; border-radius: 7px; border-width: 2px; border-color: #1a1013; margin-right: 8px; }
.tip-flavor { font-size: 15px; color: #4a3a30; margin-top: 12px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
/* 스크롤 막대: 잉크 홈 + 양피지 손잡이 */
.unity-scroller--vertical { width: 14px; }
.unity-scroller .unity-scroller__low-button, .unity-scroller .unity-scroller__high-button { display: none; }
.unity-scroller .unity-base-slider__tracker { background-color: #1e1418; border-width: 2px; border-color: #0d0709; border-radius: 2px; }
.unity-scroller .unity-base-slider__dragger { background-color: #cdb892; border-width: 2px; border-color: #1a1013; border-radius: 2px; }
.unity-scroller .unity-base-slider__dragger-border { display: none; }
.choice-grid { flex-direction: row; flex-wrap: wrap; margin-top: 20px; }
/* 일반 선택 카드(다락 강화·상점): 바느질 테두리 종이 카드 */
.choice {
    width: 300px; min-height: 196px; margin: 0 16px 16px 0; flex-direction: column; align-items: flex-start; justify-content: flex-start; padding: 24px 36px 24px 36px;
    background-image: url("project://database/Assets/UI/Paper/card.png");
    -unity-slice-left: 44; -unity-slice-right: 44; -unity-slice-top: 44; -unity-slice-bottom: 44;
    -unity-slice-scale: 0.7px;
    -unity-background-image-tint-color: #ffffff;
    color: #eadcc4; -unity-text-align: upper-left;
}
.choice:hover { -unity-background-image-tint-color: #ffe9ef; color: #ffffff; }
.choice .icon { width: 44px; height: 44px; margin-bottom: 8px; -unity-background-scale-mode: scale-to-fit; }
.choice .tag-line { color: #d6b06e; font-size: 15px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.choice .name { color: #f3e2c8; font-size: 24px; margin: 4px 0; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}
.choice .text { color: #c9b8a6; font-size: 15px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.choice .foot { color: #d6b06e; font-size: 15px; margin-top: 8px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.shop-grid .choice { width: 440px; min-height: 140px; }
.ui-vfx { position: absolute; right: 40px; top: 40px; width: 300px; height: 300px; opacity: 0.5; -unity-background-scale-mode: scale-to-fit; }

/* ---------- dialogs: 밝은 양피지 판 + 잉크 글자 ---------- */
.overlay { align-items: center; justify-content: center; background-color: rgba(14, 8, 11, 0.74); }
.dialog {
    width: 900px; padding: 60px 74px 56px 74px; color: #2e2120;
    background-image: url("project://database/Assets/UI/Paper/panel_light.png");
    -unity-slice-left: 72; -unity-slice-right: 72; -unity-slice-top: 72; -unity-slice-bottom: 72;
    -unity-slice-scale: 0.9px;
}
#dialog-augment, #dialog-artifact, #dialog-shop { width: 1200px; }
.dialog .eyebrow { font-size: 15px; color: #7d2f3e; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.dialog-title { font-size: 45px; color: #1f1416; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.dialog-text { color: #4e3b31; margin-top: 10px; }
.notice { position: absolute; bottom: 58px; left: 0; right: 0; align-items: center; }
.notice > Label {
    padding: 12px 40px 14px 40px; color: #2e2120;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    background-image: url("project://database/Assets/UI/Paper/button.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 44; -unity-slice-bottom: 44;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: #ecdcbc;
}
.room-flash { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }
.room-flash > VisualElement { width: 560px; height: 560px; -unity-background-scale-mode: scale-to-fit; background-image: url("project://database/Assets/vfx/stitch.png"); }

/* ---------- 하단 경험치 바 (메이플식, 찢어진 어두운 종이 띠) ---------- */
.exp-bar {
    position: absolute; left: -24px; right: -24px; bottom: -14px; height: 56px; flex-direction: row; align-items: center; padding: 0 34px 10px 34px;
    background-image: url("project://database/Assets/UI/Paper/panel_dark.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64;
    -unity-slice-scale: 0.4px;
}
.exp-level {
    width: 96px; padding: 3px 0 4px 0; -unity-text-align: middle-center; color: #2e2120; font-size: 15px; margin-right: 6px;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    background-image: url("project://database/Assets/UI/Paper/button.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 44; -unity-slice-bottom: 44;
    -unity-slice-scale: 0.28px;
    -unity-background-image-tint-color: #e8cf86;
}
.exp-frame { flex-grow: 1; height: 32px; }
.exp-frame .bar-track { left: 10px; right: 11px; top: 8px; bottom: 8px; }
.exp-frame .bar-ink { -unity-slice-scale: 0.28px; }
.exp-track { background-color: #1e1418; overflow: hidden; }
.exp-fill {
    position: absolute; left: 0; top: 0; bottom: 0; width: 0;
    background-image: url("project://database/Assets/UI/Paper/grain.png");
    background-size: 256px 128px; background-repeat: repeat repeat;
    -unity-background-image-tint-color: #b3c84a;
    border-right-width: 2px; border-color: #f2ffb8;
}
.exp-shine { position: absolute; left: 0; right: 0; top: 0; height: 35%; background-color: rgba(255, 255, 255, 0.2); }
.exp-tick { position: absolute; top: 0; bottom: 0; width: 2px; background-color: rgba(10, 5, 8, 0.55); }
.exp-text { position: absolute; left: 0; right: 0; top: -2px; bottom: 0; -unity-text-align: middle-center; color: #ffffff; font-size: 12px; -unity-text-outline-width: 1px; -unity-text-outline-color: #120c10; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }

/* ---------- 퍼즐 카드 (증강·아이템 선택): 바느질 종이 카드를 등급 색으로 물들임 ---------- */
.puzzle-grid { flex-direction: row; justify-content: center; margin-top: 34px; }
.puzzle {
    width: 300px; min-height: 350px; margin: 0 20px 10px 20px; padding: 6px 4px 14px 4px; flex-direction: column; align-items: stretch; justify-content: flex-start;
    background-image: url("project://database/Assets/UI/Paper/card.png");
    -unity-slice-left: 44; -unity-slice-right: 44; -unity-slice-top: 44; -unity-slice-bottom: 44;
    -unity-slice-scale: 0.8px;
    border-width: 0; overflow: visible; -unity-text-align: upper-center; color: #eadcc4;
    transition-property: translate, scale; transition-duration: 0.12s;
}
.puzzle:hover { scale: 1.04 1.04; translate: 0 -6px; }
.knob { position: absolute; width: 36px; height: 36px; border-radius: 18px; background-color: #e6a8bf; border-width: 3px; border-color: #160e11; }
.knob-top { top: -22px; left: 132px; }
.knob-right { right: -22px; top: 150px; }
.notch { position: absolute; width: 32px; height: 32px; border-radius: 16px; background-color: #cdb892; border-width: 3px; border-color: #160e11; }
.notch-left { left: -14px; top: 152px; }
.puzzle-band {
    height: 40px; margin: 10px -16px 0 -16px; justify-content: center;
    background-image: url("project://database/Assets/UI/Paper/button.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 44; -unity-slice-bottom: 44;
    -unity-slice-scale: 0.36px;
}
.puzzle-tag { color: #f6e8d2; font-size: 18px; -unity-text-outline-width: 1.8px; -unity-text-outline-color: #160e11; -unity-text-align: middle-center; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }
.puzzle-body { align-items: center; padding: 14px 32px 20px 32px; }
.puzzle-frame { width: 108px; height: 108px; border-radius: 54px; background-color: #1a1115; border-width: 4px; border-color: #e6a8bf; align-items: center; justify-content: center; margin-bottom: 10px; }
.puzzle-icon { width: 86px; height: 86px; -unity-background-scale-mode: scale-to-fit; }
.puzzle-name { color: #f6e8d2; font-size: 24px; margin-bottom: 4px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); -unity-text-outline-width: 1px; -unity-text-outline-color: #1a1013; }
.puzzle-effect { color: #f2d27e; font-size: 15px; -unity-text-align: upper-center; margin-bottom: 6px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); white-space: normal; }
.puzzle-shape { width: 56px; height: 30px; margin: 4px 0 6px 0; }
.puzzle-text { color: #cdbcaa; font-size: 15px; white-space: normal; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset"); }

/* ---------- 다시 굴리기 · 등급 번쩍임 · 등반 중 재봉 상자 ---------- */
.reroll-row { justify-content: center; margin-top: 22px; }
.reroll { min-width: 240px; -unity-background-image-tint-color: #c9b490; }
.reroll:disabled { opacity: 0.45; }
.shine-clip { position: absolute; left: 10px; right: 10px; top: 10px; bottom: 10px; overflow: hidden; }
.shine { position: absolute; top: -40%; bottom: -40%; width: 70px; left: -30%; rotate: 18deg; background-color: rgba(255, 246, 214, 0.22); }
.puzzle.rank-3 .shine { background-color: rgba(255, 236, 160, 0.20); }
.puzzle.rank-4 .shine { width: 90px; background-color: rgba(255, 226, 170, 0.34); }
/* 22차-ui-fixes: 레전더리, 신화 카드 등장 번쩍임 (GameUI.Entrance.cs). 뒤 빛과 바느질 고리는 카드보다 크게, 섬광은 카드 위 */
.entrance-halo { position: absolute; left: -45%; right: -45%; top: -30%; bottom: -30%; background-image: url("project://database/Assets/Art/Generated/soft_disc.png"); -unity-background-scale-mode: stretch-to-fill; }
.entrance-ring { position: absolute; left: -25%; right: -25%; top: -10%; bottom: -10%; background-image: url("project://database/Assets/vfx/stitch.png"); -unity-background-scale-mode: scale-to-fit; }
.entrance-flash { position: absolute; left: 10px; right: 10px; top: 10px; bottom: 10px; border-radius: 22px; background-color: #fff8e0; }
.room-note { color: #e2c48a; font-size: 15px; margin-top: 6px; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");}

/* 체력 회복: 새로 찰 몫이 밝게 먼저 보이고, 체력 게이지가 그 위로 차오른다 */
.meter-fill.heal { position: absolute; left: 0; top: 0; bottom: 0; -unity-background-image-tint-color: #dcfbb8; border-right-width: 0; }
.meter-fill.health { position: absolute; left: 0; top: 0; bottom: 0; }

/* 22차 보스 욕망 창: 속삭임과 두 갈래 느낌 문구 */
#dialog-desire #desire-text { -unity-font-style: italic; font-size: 20px; color: #5a2e3a; -unity-text-align: middle-center; margin: 10px 0 6px 0; white-space: normal; }
.desire-choices { flex-direction: row; justify-content: center; margin-top: 14px; }
.desire-choice { width: 46%; margin: 0 2%; align-items: stretch; }
.desire-feel { color: #4e3b31; font-size: 15px; white-space: normal; -unity-text-align: upper-center; margin-top: 8px; }
/* 22차-ui-fixes: 제목 "[죄종의 잔향]"은 죄종 색 글씨라 종이 위에서 흐려서 검은 외곽선 (수치 줄 .desire-numbers 는 지움) */
#dialog-desire #desire-name { -unity-text-outline-width: 2.6px; -unity-text-outline-color: #120a0c; text-shadow: 2px 3px 2px rgba(18, 10, 12, 0.55); }

/* 23차: 보스 욕망을 고른 뒤 잠깐 뜨는 한 줄 (GameUI.DesireEcho.cs). 움직임과 글자 번짐은 코드, 여기는 모양만.
   찢어진 종이 띠(panel_light 9-slice) 위에 잉크 글씨가 한 자씩 번지고, 아래 바느질 실이 왼쪽에서 오른쪽으로 꿰매진다. */
.floor-veil { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0); }   /* 23차: 욕망을 고른 뒤 물들고 어두워지는 막. 색은 코드가 매 프레임 (GameController.FloorFade.cs) */
.desire-echo { position: absolute; left: 0; right: 0; top: 226px; align-items: center; }   /* 층 이름 띠(.banner, top 146px)의 아래, 층 암시 줄(.floor-hint, 36%) 위. 층 암시는 쪽지가 사라진 뒤에 뜬다(ElementHud) */
.desire-echo-paper {
    min-width: 560px; height: 150px; padding: 0 70px 10px 70px; justify-content: center; align-items: center;
    background-image: url("project://database/Assets/UI/Paper/panel_light.png");
    -unity-slice-left: 72; -unity-slice-right: 72; -unity-slice-top: 72; -unity-slice-bottom: 72; -unity-slice-scale: 0.6px;
}
.desire-echo-text {
    font-size: 40px; -unity-text-align: middle-center; white-space: nowrap; letter-spacing: 2px;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
}
.desire-echo-seam { position: absolute; left: 70px; right: 70px; bottom: 30px; height: 7px; overflow: hidden; }
.desire-echo-thread {
    position: absolute; left: 0; top: 0; bottom: 0; width: 0;
    background-image: url("project://database/Assets/UI/Puzzle/stitch_h.png"); background-repeat: repeat-x; background-size: 16px 100%;
}
.desire-echo-blot {
    position: absolute; right: 10px; top: -30px; width: 150px; height: 110px; opacity: 0; rotate: 18deg;
    background-image: url("project://database/Assets/UI/Paper/blood_2.png"); -unity-background-scale-mode: scale-to-fit;
}
/* 삼킴: 검붉은 잉크, 붉은 실, 종이 모서리에 핏자국 */
.desire-echo.swallow .desire-echo-paper { -unity-background-image-tint-color: rgb(244, 226, 214); }
.desire-echo.swallow .desire-echo-text { color: #6e1420; }
.desire-echo.swallow .desire-echo-thread { -unity-background-image-tint-color: #9a1c26; }
/* 안 삼킴: 식어 가는 잿빛 잉크, 빛바랜 종이, 옅은 실 */
.desire-echo.refuse .desire-echo-paper { -unity-background-image-tint-color: rgb(214, 214, 212); }
.desire-echo.refuse .desire-echo-text { color: #3c4652; }
.desire-echo.refuse .desire-echo-thread { -unity-background-image-tint-color: #7d8894; }
.desire-echo.refuse .desire-echo-blot { display: none; }

/* 23차-boss-dev: 타이머 오른쪽 "3층 2라운드", 보스 이름 옆 층, 일시정지 버튼 아래 기억의 파편 수 */
.round-timer > .floor-round {
    position: absolute; left: 50%; top: 18px; margin-left: 112px; min-width: 0;
    padding: 7px 20px 10px 20px; font-size: 24px; color: #f3e2c8; -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    -unity-text-outline-width: 1px; -unity-text-outline-color: #1a1013;
    background-image: url("project://database/Assets/UI/Paper/panel_dark.png");
    -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64;
    -unity-slice-scale: 0.3px;
}
.round-timer.urgent > .floor-round { color: #f3e2c8; -unity-background-image-tint-color: #ffffff; }
.boss-floor {
    margin-left: 16px; font-size: 22px; color: #c9b49c; -unity-font-definition: url("project://database/Assets/Fonts/Jua/Jua_SDF.asset");
    -unity-text-outline-width: 1px; -unity-text-outline-color: #1a1013;
}
.hud-shards {
    position: absolute; right: 22px; top: 82px; width: 60px; margin-right: 0;
    flex-direction: column; align-items: center; font-size: 22px;
}
.hud-shards > VisualElement { width: 34px; height: 34px; margin-right: 0; transition-property: scale; transition-duration: 0.12s; }
.hud-shards > Label { margin-top: -4px; -unity-text-align: middle-center; transition-property: scale, color; transition-duration: 0.12s; }
.hud-shards.bump > VisualElement { scale: 1.3 1.3; }
.hud-shards.bump > Label { scale: 1.5 1.5; color: #d6ecff; }

/* 23차-boss7: 2페이즈 보스 체력바 (더 붉게), 전환 중 체력바가 다시 차오를 때 밝게 */
.boss-hud.phase2 .meter-fill.boss { -unity-background-image-tint-color: #d8341e; }
.boss-hud.refill .meter-fill.boss { -unity-background-image-tint-color: #ff8a4a; }
