<!-- 작은 반복 요소 템플릿: 판 칸, 털실 칸, 대쉬 칸, 조각 점, 전투 글자, 퍼즐 카드. GameUI 가 이름으로 골라 복제한다. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Button name="cell" class="cell" />
    <!-- 19차 모이라 줄 고르기: 판 위 반투명 띠(강화한 줄, 마우스를 올린 줄)와 확장 가장자리 띠 (GameUI.Board.cs) -->
    <ui:VisualElement name="pick-band" class="pick-band" picking-mode="Ignore" />
    <!-- 21차 강화한 칸: 칸 오른쪽 위 "+N" (가로 줄 + 세로 줄 강화 횟수) -->
    <ui:Label name="cell-badge" class="cell-badge" picking-mode="Ignore" />
    <ui:Button name="pick-strip" class="pick-strip" />
    <!-- 20차 칸 강화, 확장 연출 (GameUI.Board.cs PlayLineGrow): 실, 실 머리 빛, 칸 번쩍임 -->
    <ui:VisualElement name="grow-thread" class="grow-thread" picking-mode="Ignore" />
    <ui:VisualElement name="grow-head" class="grow-glow grow-head" picking-mode="Ignore" />
    <ui:VisualElement name="grow-flash" class="grow-glow grow-flash" picking-mode="Ignore" />
    <ui:VisualElement name="yarn-pip" class="yarn-pip"><ui:VisualElement name="wind" class="yarn-wind" /></ui:VisualElement>
    <ui:VisualElement name="piece-dot" class="piece-dot" picking-mode="Ignore" />
    <ui:Label name="world-label" class="world-label" picking-mode="Ignore" />
    <!-- 재봉 상자 퍼즐 한 칸 그림: 종이 · 잉크(레전더리는 금박) 테두리(둘 다 Puzzle.uss 의 k{n} 마스크) · 아이템 슬롯(눌린 홈 + 모서리 땀) · 바깥 변 바늘땀 · 장식 · 세트 매듭 · 반짝임 -->
    <ui:VisualElement name="piece-tile" class="piece-tile" picking-mode="Ignore">
        <ui:VisualElement name="paper" class="tile-paper" picking-mode="Ignore">
            <ui:VisualElement name="shine" class="tile-shine" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="edge" class="tile-edge" picking-mode="Ignore" />
        <ui:VisualElement name="slot" class="tile-slot" picking-mode="Ignore"><ui:VisualElement class="slot-corners" picking-mode="Ignore" /></ui:VisualElement>
        <ui:VisualElement name="seam-t" class="seam seam-h" picking-mode="Ignore"><ui:VisualElement name="thread" class="thread thread-h" picking-mode="Ignore" /></ui:VisualElement>
        <ui:VisualElement name="seam-r" class="seam seam-v" picking-mode="Ignore"><ui:VisualElement name="thread" class="thread thread-v" picking-mode="Ignore" /></ui:VisualElement>
        <ui:VisualElement name="seam-b" class="seam seam-h" picking-mode="Ignore"><ui:VisualElement name="thread" class="thread thread-h" picking-mode="Ignore" /></ui:VisualElement>
        <ui:VisualElement name="seam-l" class="seam seam-v" picking-mode="Ignore"><ui:VisualElement name="thread" class="thread thread-v" picking-mode="Ignore" /></ui:VisualElement>
        <ui:VisualElement name="ornament" class="tile-ornament" picking-mode="Ignore" />
        <ui:VisualElement name="knot" class="tile-knot" picking-mode="Ignore" />
        <ui:VisualElement name="sparkle" class="tile-sparkle" picking-mode="Ignore" />
    </ui:VisualElement>
    <!-- 서로 다른 조각이 맞닿은 경계: 홈 + 건너 잇는 땀 -->
    <ui:VisualElement name="piece-join" class="piece-join" picking-mode="Ignore"><ui:VisualElement name="join-art" class="join-art" picking-mode="Ignore" /></ui:VisualElement>
    <!-- 장착 바느질 끝의 매듭 불티 -->
    <ui:VisualElement name="sew-spark" class="sew-spark" picking-mode="Ignore" />
    <!-- 판 위 조각의 아이템 아이콘 (회전 중심 칸에 하나) -->
    <ui:VisualElement name="piece-mark" class="piece-mark" picking-mode="Ignore" />
    <!-- 판 위 조각의 세트 이름 (예: 화염), 세트 색 글씨 -->
    <ui:VisualElement name="board-set-tag" class="board-set-row" picking-mode="Ignore">
        <ui:Label name="tag" class="board-set-tag" picking-mode="Ignore" />
    </ui:VisualElement>
    <!-- 세트 효과 패널 항목과 단계 줄 -->
    <ui:VisualElement name="set-entry" class="set-entry">
        <ui:VisualElement class="set-head">
            <ui:VisualElement name="swatch" class="set-swatch" />
            <ui:Label name="set-name" class="set-name" />
            <ui:Label name="set-count" class="set-count" />
        </ui:VisualElement>
        <ui:Label name="set-role" class="set-role" />
        <ui:VisualElement name="tiers" class="set-tiers" />
    </ui:VisualElement>
    <ui:VisualElement name="set-tier" class="set-tier">
        <ui:Label name="need" class="tier-need" />
        <ui:Label name="effect" class="tier-effect" />
    </ui:VisualElement>
    <ui:VisualElement name="dash-pip" class="dash-pip"><ui:VisualElement name="fill" class="dash-fill" /></ui:VisualElement>
    <!-- 증강·아이템 선택 카드 (퍼즐 조각 모양: 위·오른쪽 돌기, 왼쪽 홈) -->
    <ui:Button name="puzzle" class="puzzle">
        <ui:VisualElement name="knob-top" class="knob knob-top" picking-mode="Ignore" />
        <ui:VisualElement name="knob-right" class="knob knob-right" picking-mode="Ignore" />
        <ui:VisualElement name="notch-left" class="notch notch-left" picking-mode="Ignore" />
        <ui:VisualElement name="shine-clip" class="shine-clip" picking-mode="Ignore"><ui:VisualElement name="shine" class="shine" picking-mode="Ignore" /></ui:VisualElement>
        <ui:VisualElement name="band" class="puzzle-band" picking-mode="Ignore"><ui:Label name="tag" class="puzzle-tag" picking-mode="Ignore" /></ui:VisualElement>
        <ui:VisualElement class="puzzle-body" picking-mode="Ignore">
            <ui:VisualElement name="frame" class="puzzle-frame" picking-mode="Ignore"><ui:VisualElement name="icon" class="puzzle-icon" picking-mode="Ignore" /></ui:VisualElement>
            <ui:Label name="name" class="puzzle-name" picking-mode="Ignore" />
            <ui:Label name="effect" class="puzzle-effect" picking-mode="Ignore" />
            <ui:VisualElement name="shape" class="puzzle-shape" picking-mode="Ignore" />
            <ui:Label name="text" class="puzzle-text" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
