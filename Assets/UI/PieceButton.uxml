<!-- 재봉 상자 목록 한 줄: 왼쪽 아이템 아이콘 · 퍼즐 모양(위에 세트 이름 꼬리표) · 오른쪽 끝 이름(아래에 장착 중, 등급 색 꼬리표). 높이 = 판 한 칸의 1.3배. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Button name="piece" class="piece-row">
        <ui:VisualElement name="icon" class="piece-item-icon" picking-mode="Ignore" />
        <ui:VisualElement class="piece-shape-col" picking-mode="Ignore">
            <ui:Label name="set" class="piece-set" picking-mode="Ignore" />
            <ui:VisualElement name="shape" class="piece-shape-slot" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="piece-name-box" picking-mode="Ignore">
            <ui:Label name="name" class="piece-name" picking-mode="Ignore" />
            <ui:Label name="state" class="piece-state" picking-mode="Ignore" />
            <ui:Label name="rank" class="piece-rank" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- 23차: 장착 중 테두리 (금빛 빛 + 금실 바느질, .piece-row.equipped 일 때만 보임) -->
        <ui:VisualElement name="equip-frame" class="piece-equip" picking-mode="Ignore">
            <ui:VisualElement class="piece-equip-glow" picking-mode="Ignore" />
            <ui:VisualElement class="piece-equip-stitch top" picking-mode="Ignore" />
            <ui:VisualElement class="piece-equip-stitch bottom" picking-mode="Ignore" />
            <ui:VisualElement class="piece-equip-stitch left" picking-mode="Ignore" />
            <ui:VisualElement class="piece-equip-stitch right" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
