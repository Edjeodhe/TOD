    poseHold: 1.6
    breathAmount: 0.022
    breathSpeed: 0.55
    popTime: 0.32
    popSquash: 0.14
    popHop: 9
    tiltAngle: 9
    tiltTime: 0.7
    hopHeight: 16
    hopTime: 0.75
    hopCount: 2
    shakeAngle: 8
    shakeTime: 0.6
    shakeCount: 3
    talkAngle: 1.6
    talkSpeed: 3.2
    lines:
    - cue: 0
      mood: 2
      lines:
      - "\uD760\uD760, \uC624\uB298\uB3C4 \uD0D1\uC5D0\uC11C \uC88B\uC740 \uB0C4\uC0C8\uAC00
        \uB098\uB294\uAD70."
      - "\uC5B4\uC774, \uAC70\uAE30 \uAF2C\uB9C8 \uC7AC\uBD09\uC0AC. \uAD6C\uACBD\uC740
        \uACF5\uC9DC\uB77C\uB124."
      - "\uC774 \uB2E8\uCD94 \uB208\uC740 \uC7A5\uC2DD\uC774 \uC544\uB2C8\uC57C.
        \uB2E4 \uBCF4\uACE0 \uC788\uC9C0."
      - "\uC27F, \uBC29\uAE08 \uBC18\uC9DD\uC774\uB294 \uAC78 \uD558\uB098 \uC8FC\uC6E0\uAC70\uB4E0."
      - "\uB450\uB354\uC9C0 \uCF54\uB294 \uC190\uB2D8 \uB0C4\uC0C8\uB97C \uC808\uB300
        \uC548 \uB193\uCCD0."
    - cue: 1
      mood: 1
      lines:
      - "\uC5B4\uC11C \uC624\uAC8C! \uB2E8\uCD94\uB124 \uBCF4\uB530\uB9AC\uB294 \uC5B8\uC81C\uB098
        \uC5F4\uB824 \uC788\uC9C0."
      - "\uC624\uD638, \uC190\uB2D8\uC774\uAD70. \uC8FC\uBA38\uB2C8 \uC18C\uB9AC\uAC00
        \uC9E4\uB791\uC9E4\uB791\uD558\uB294\uB370?"
      - "\uACE8\uB77C \uBCF4\uAC8C. \uB2E4 \uD0D1 \uAF2D\uB300\uAE30\uC5D0\uC11C
        \uB5A8\uC5B4\uC9C4 \uC9C4\uC9DC\uBC30\uAE30\uC57C. \uC544\uB9C8\uB3C4."
      - "\uBC18\uAC00\uC6CC, \uBC18\uAC00\uC6CC. \uC624\uB298\uC740 \uD2B9\uBCC4\uD788
        \uB35C \uC218\uC0C1\uD55C \uBB3C\uAC74\uB9CC \uAC00\uC838\uC654\uC9C0."
    - cue: 2
      mood: 3
      lines:
      - "\uD0C1\uC6D4\uD55C \uC120\uD0DD\uC774\uC57C! \uADF8 \uBB3C\uAC74\uC774 \uC790\uB12C
        \uAE30\uB2E4\uB838\uB2E4\uB124."
      - "\uAC70\uB798 \uC131\uC0AC! \uC601\uC218\uC99D\uC740 \uC5C6\uB124, \uB450\uB354\uC9C0
        \uC804\uD1B5\uC774\uC57C."
      - "\uD788\uD788, \uC88B\uC740 \uB208\uC744 \uAC00\uC84C\uAD70. \uC544\uBC84\uC9C0\uB97C
        \uB2EE\uC558\uB098?"
      - "\uC798 \uAFF0\uB9E4 \uC4F0\uAC8C. \uD658\uBD88\uC740 \uD0D1 \uAF2D\uB300\uAE30\uC5D0\uC11C\uB9CC
        \uBC1B\uC544."
    - cue: 3
      mood: 4
      lines:
      - "\uC5D0\uC774, \uC8FC\uBA38\uB2C8\uAC00 \uBAA8\uC790\uB77C\uC796\uB098. \uC678\uC0C1\uC740
        \uC548 \uB3FC."
      - "\uD760, \uADF8 \uC8FC\uBA38\uB2C8\uB85C\uB294 \uB2E8\uCD94 \uD558\uB098\uB3C4
        \uBABB \uC0AC\uACA0\uB294\uAC78."
      - "\uACF5\uC9DC\uB294 \uC5C6\uC5B4, \uAF2C\uB9C8. \uB098\uB3C4 \uBA39\uACE0\uC0B4\uC544\uC57C\uC9C0."
      - "\uC870\uAE08 \uB354 \uBAA8\uC544 \uC624\uAC8C. \uADF8\uB7FC \uC0DD\uAC01\uD574
        \uBCF4\uC9C0."
    - cue: 4
      mood: 4
      lines:
      - "\uADF8\uAC74 \uBC8C\uC368 \uC790\uB124 \uAC70\uC57C. \uB450 \uBC88 \uD314\uBA74
        \uC591\uC2EC\uC5D0 \uAD6C\uBA4D \uB098."
      - "\uC774\uBBF8 \uD314\uB9B0 \uBB3C\uAC74\uC774\uB77C\uB124. \uB2E4\uB978 \uAC78
        \uBCF4\uAC8C."
      - "\uC5B4\uD5C8, \uAC19\uC740 \uAC78 \uB610 \uC0AC\uB824\uACE0? \uC695\uC2EC\uC774
        \uD0D1\uB9CC\uD07C \uB192\uAD6C\uBA3C."
      - "\uADF8 \uC790\uB9AC\uB294 \uBE44\uC5C8\uC5B4. \uB0B4 \uBCF4\uB530\uB9AC\uB3C4
        \uBC14\uB2E5\uC740 \uC788\uB2E4\uB124."
    - cue: 5
      mood: 5
      lines:
      - "\uB610 \uC624\uAC8C! \uD0D1\uC5D0\uC11C \uC0B4\uC544\uC11C \uB9D0\uC774\uC57C."
      - "\uC798 \uAC00\uAC8C. \uAE38 \uC783\uC73C\uBA74 \uB2E8\uCD94 \uB0C4\uC0C8\uB97C
        \uB530\uB77C\uC640."
      - "\uB2E4\uC74C\uC5D4 \uB354 \uC218\uC0C1\uD55C \uAC78 \uAC00\uC838\uC624\uC9C0.
        \uD788\uD788."
      - "\uC870\uC2EC\uD558\uAC8C, \uC704\uCE35 \uB140\uC11D\uB4E4\uC740 \uC190\uB2D8
        \uB300\uC811\uC744 \uBAB0\uB77C."
