    moiraLines:
    - "\uC5B4\uC11C \uC624\uB834, \uC791\uC740 \uC7AC\uBD09\uC0AC. \uB124 \uC2E4\uC774
      \uC5B4\uB514\uB85C \uBED7\uC744\uC9C0 \uAC19\uC774 \uBCFC\uAE4C?"
    - "\uC810\uC131\uAD6C \uC18D \uC2E4\uC774 \uC5C9\uCF1C \uC788\uAD6C\uB098. \uD30C\uD3B8
      \uBA87 \uAC1C\uBA74 \uD480\uC5B4 \uC904 \uC218 \uC788\uC9C0."
    - "\uD0D1\uC740 \uC695\uB9DD\uC744 \uBA39\uACE0 \uC790\uB780\uB2E8\uB2E4. \uD310\uC774
      \uB113\uC744\uC218\uB85D \uB354 \uC624\uB798 \uBC84\uD2F8 \uC218 \uC788\uC5B4."
    - "\uB124 \uC544\uBC84\uC9C0\uC758 \uC2E4\uB3C4 \uC5EC\uAE30 \uAC10\uACA8 \uC788\uC5C8\uC9C0.
      \uADF8 \uB05D\uC740 \uC544\uC9C1 \uBCF4\uC774\uC9C0 \uC54A\uB294\uAD6C\uB098."
    - "\uC5EC\uB35F \uB208\uC73C\uB85C \uBD10\uB3C4 \uBBF8\uB798\uB294 \uB298 \uD55C
      \uC62C\uC529\uB9CC \uBCF4\uC5EC \uC900\uB2E8\uB2E4."
    moiraEmpty: "\uB354 \uAC10\uC744 \uC2E4\uC774 \uC5C6\uAD6C\uB098. \uC774\uC81C
      \uB124 \uC190\uC5D0 \uB2EC\uB838\uB2E8\uB2E4."
    pickRows: "\uAC15\uD654\uD560 \uAC00\uB85C \uC904\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C
      \uC62C\uB9AC\uACE0 \uB204\uB974\uC138\uC694. \uCE78 \uC624\uB978\uCABD \uC544\uB798
      \uC22B\uC790\uB294 \uADF8 \uCE78\uC744 \uAC15\uD654\uD55C \uD69F\uC218\uC785\uB2C8\uB2E4.
      (Esc \uB3CC\uC544\uAC00\uAE30)"
    pickCols: "\uAC15\uD654\uD560 \uC138\uB85C \uC904\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C
      \uC62C\uB9AC\uACE0 \uB204\uB974\uC138\uC694. \uCE78 \uC624\uB978\uCABD \uC544\uB798
      \uC22B\uC790\uB294 \uADF8 \uCE78\uC744 \uAC15\uD654\uD55C \uD69F\uC218\uC785\uB2C8\uB2E4.
      (Esc \uB3CC\uC544\uAC00\uAE30)"
    pickExpand: "\uC904\uC744 \uBD99\uC77C \uAC00\uC7A5\uC790\uB9AC\uB97C \uB204\uB974\uC138\uC694.
      \uC704\uB098 \uC67C\uCABD\uC5D0 \uBD99\uC774\uBA74 \uB193\uC778 \uC870\uAC01\uC774
      \uD55C \uCE78\uC529 \uBC00\uB9BD\uB2C8\uB2E4. (Esc \uB3CC\uC544\uAC00\uAE30)"
    pickTitle: "{0}: \uC790\uB9AC \uACE0\uB974\uAE30"
    confirmRow: "\uC704\uC5D0\uC11C {0}\uBC88\uC9F8 \uAC00\uB85C \uC904\uC744 \uAC15\uD654\uD569\uB2C8\uB2E4.
      \uAE30\uC5B5\uC758 \uD30C\uD3B8 {1}\uAC1C\uB97C \uC501\uB2C8\uB2E4."
    confirmCol: "\uC67C\uCABD\uC5D0\uC11C {0}\uBC88\uC9F8 \uC138\uB85C \uC904\uC744
      \uAC15\uD654\uD569\uB2C8\uB2E4. \uAE30\uC5B5\uC758 \uD30C\uD3B8 {1}\uAC1C\uB97C
      \uC501\uB2C8\uB2E4."
    confirmExpand: "\uD310 {0}\uC5D0 \uC904 \uD558\uB098\uB97C \uBD99\uC785\uB2C8\uB2E4.
      \uAE30\uC5B5\uC758 \uD30C\uD3B8 {1}\uAC1C\uB97C \uC501\uB2C8\uB2E4."
    confirmPlain: "\uAE30\uC5B5\uC758 \uD30C\uD3B8 {0}\uAC1C\uB97C \uC368\uC11C {1}\uC744
      \uAC15\uD654\uD569\uB2C8\uB2E4."
