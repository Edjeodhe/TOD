  diary:
    entries:
    - floor: 1
      title: "\uCCAB\uC9F8 \uC7A5, \uC7BF\uBE5B \uBB38\uD131"
      lines:
      - "\uD0D1\uC758 \uCCAB \uACC4\uB2E8\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uB0AE\uC558\uB2E4.
        \uB204\uAD6C\uB77C\uB3C4 \uC624\uB97C \uC218 \uC788\uAC8C \uB9CC\uB4E0 \uAC83\uC774\uB2E4."
      - "\uBB38\uD131\uB9C8\uB2E4 \uC2E4\uBC25 \uAC19\uC740 \uAC83\uC774 \uAC78\uB824
        \uC788\uC5C8\uB2E4. \uB204\uAD70\uAC00 \uAFF0\uB9E4\uB2E4 \uB9CC \uC18C\uC6D0\uB4E4\uC774\uB2E4."
      - "\uBC14\uB298\uC744 \uC954 \uC190\uC774 \uB5A8\uB9B0\uB2E4. \uC791\uC5C5\uB300\uC5D0
        \uB450\uACE0 \uC628 \uC544\uC774 \uC5BC\uAD74\uC774 \uC790\uAFB8 \uB5A0\uC624\uB978\uB2E4."
      - "\uD55C \uCE35\uB9CC \uBCF4\uACE0 \uB0B4\uB824\uAC00\uACA0\uB2E4. \uC815\uB9D0
        \uD55C \uCE35\uB9CC."
      absorbedLine: "(\uB0B4 \uAE00\uC528) \uC544\uBC84\uC9C0, \uC800\uB3C4 \uD55C
        \uCE35\uB9CC\uC774\uB77C\uACE0 \uB9D0\uD574 \uBC84\uB838\uC5B4\uC694. \uC190\uB05D\uC774
        \uC544\uC9C1 \uB728\uAC70\uC6CC\uC694."
      refusedLine: "(\uB0B4 \uAE00\uC528) \uC544\uBC84\uC9C0, \uC800\uB294 \uD55C
        \uCE35\uC5D0\uC11C \uBA48\uCD9C \uC904 \uC54C\uC544\uC694. \uADF8\uB7EC\uB2C8
        \uC870\uAE08\uB9CC \uAE30\uB2E4\uB824 \uC8FC\uC138\uC694."
      tilt: -4
      readShards: 3
      patternKind: 35
      patternTainted: 42
      blood: 0
      ink: {r: 0, g: 0, b: 0, a: 0}
    - floor: 2
      title: "\uB458\uC9F8 \uC7A5, \uC190\uC5D0 \uBD99\uC740 \uC2E4"
      lines:
      - "\uD55C \uCE35\uB9CC\uC774\uB77C\uACE0 \uD588\uB294\uB370, \uC815\uC2E0\uC744
        \uCC28\uB824 \uBCF4\uB2C8 \uACC4\uB2E8\uC774 \uBA3C\uC800 \uBC1C\uBC11\uC5D0
        \uC640 \uC788\uC5C8\uB2E4."
      - "\uC2E4 \uD55C \uD0C0\uB798\uB97C \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uC5C8\uB2E4.
        \uB0B4 \uAC83\uB3C4 \uC544\uB2CC\uB370 \uC190\uC774 \uBA3C\uC800 \uC6C0\uC9C1\uC600\uB2E4."
      - "\uBC24\uC0C8 \uAC10\uACE0 \uB610 \uD480\uC5C8\uB2E4. \uC190\uB05D\uC774
        \uAC08\uB77C\uC838 \uC2E4\uC774 \uBD89\uAC8C \uBB3C\uB4E4\uC5C8\uB2E4. \uADF8\uB798\uB3C4
        \uACF1\uB2E4. \uCC38 \uACF1\uB2E4."
      - "\uC544\uC774\uC5D0\uAC8C \uD3B8\uC9C0\uB97C \uC4F0\uB824\uB2E4 \uC2E4 \uC774\uC57C\uAE30\uB9CC
        \uC138 \uC7A5\uC744 \uC37C\uB2E4. \uC774\uB984\uC744 \uC801\uB294 \uAC78
        \uC78A\uC5C8\uB2E4. \uB2E4\uC74C\uC5D4 \uAF2D."
      absorbedLine: "(\uB0B4 \uAE00\uC528) \uC81C \uC8FC\uBA38\uB2C8\uB3C4 \uBB34\uAC70\uC6CC\uC84C\uC5B4\uC694.
        \uADF8 \uC2E4\uC774 \uB530\uB73B\uD574\uC11C \uB193\uAE30\uAC00 \uC2EB\uC5B4\uC694."
      refusedLine: "(\uB0B4 \uAE00\uC528) \uC800\uB294 \uC2E4\uC744 \uB04A\uC5C8\uC5B4\uC694.
        \uC544\uBC84\uC9C0 \uC190\uC5D0 \uBD99\uC740 \uAC83\uB3C4 \uC81C\uAC00 \uB04A\uC5B4
        \uB4DC\uB9B4\uAC8C\uC694."
      tilt: 3
      readShards: 6
      patternKind: 36
      patternTainted: 43
      blood: 0.2
      ink: {r: 0.21176471, g: 0.1254902, b: 0.11372549, a: 1}
    - floor: 3
      title: "\uC14B\uC9F8 \uC7A5, \uBD89\uC740 \uC5F0\uD68C"
      lines:
      - "\uC2DD\uD0C1\uC740 \uB05D\uC774 \uC5C6\uC5C8\uB2E4. \uB2E4\uB4E4 \uC6C3\uC73C\uBA70
        \uBA39\uB294\uB370 \uC544\uBB34\uB3C4 \uBC30\uBD80\uB974\uC9C0 \uC54A\uC558\uB2E4.
        \uB098\uB3C4 \uC549\uC558\uB2E4. \uC870\uAE08\uB9CC."
      - "\uB0B4\uAC00 \uAFF0\uB9E4 \uC900 \uC678\uD22C\uB97C \uC785\uC740 \uC190\uB2D8\uC774
        \uC788\uC5C8\uB2E4. \uC678\uD22C\uAC00 \uD53C\uC5D0 \uC816\uC5B4 \uC788\uC5C8\uB2E4.
        \uACE0\uCCD0 \uC8FC\uACE0 \uC2F6\uC5C8\uB2E4. \uC544\uB2C8, \uADF8 \uC678\uD22C\uAC00
        \uAC16\uACE0 \uC2F6\uC5C8\uB2E4."
      - "\uBC14\uB298\uC5D0 \uBB3B\uC740 \uAC83\uC774 \uB9C8\uB974\uC9C0 \uC54A\uB294\uB2E4.
        \uB2E6\uC544\uB3C4, \uB2E6\uC544\uB3C4, \uB2E6\uC544\uB3C4."
      - "\uD654\uAC00 \uB09C\uB2E4. \uC65C\uC778\uC9C0\uB294 \uBAA8\uB974\uACA0\uB2E4.
        <s>\uC9D1\uC5D0 \uB3CC\uC544\uAC00</s> \uC704\uCE35\uC5D0 \uB354 \uC88B\uC740
        \uC2E4\uC774 \uC788\uB2E4\uACE0 \uB4E4\uC5C8\uB2E4."
      absorbedLine: "(\uB0B4 \uAE00\uC528) \uC624\uB298\uC740 \uC774\uC720 \uC5C6\uC774
        \uD654\uAC00 \uB0AC\uC5B4\uC694. \uBC14\uB298 \uB05D\uC774 \uBD89\uC5B4\uB3C4
        \uC774\uC0C1\uD558\uC9C0 \uC54A\uC558\uC5B4\uC694."
      refusedLine: "(\uB0B4 \uAE00\uC528) \uD654\uB294 \uC2DD\uD0C1\uC5D0 \uB450\uACE0
        \uC654\uC5B4\uC694. \uADF8 \uB05D\uC5D0 \uC544\uBC84\uC9C0 \uC790\uB9AC\uB294
        \uC5C6\uC5C8\uC5B4\uC694."
      tilt: -2
      readShards: 9
      patternKind: 37
      patternTainted: 44
      blood: 0.4
      ink: {r: 0.25882354, g: 0.101960786, b: 0.09411765, a: 1}
    - floor: 4
      title: "\uB137\uC9F8 \uC7A5, \uAC70\uC6B8 \uC18D \uC7AC\uBD09\uC0AC"
      lines:
      - "\uAC70\uC6B8\uB9C8\uB2E4 \uB0B4\uAC00 \uC788\uC5C8\uB2E4. \uB354 \uD070
        \uC791\uC5C5\uC2E4, \uB354 \uBE44\uC2FC \uC2E4, \uB354 \uB9CE\uC740 \uC190\uB2D8.
        \uC804\uBD80 \uB0B4 \uAC83\uC774 \uB420 \uC218 \uC788\uB2E4."
      - "\uD55C \uAC70\uC6B8 \uC18D \uB098\uB294 \uC544\uC774\uB97C \uC78A\uACE0
        \uC6C3\uACE0 \uC788\uC5C8\uB2E4. \uADF8 \uC5BC\uAD74\uC774 \uAC00\uC7A5 \uD3B8\uD574
        \uBCF4\uC600\uB2E4. \uADF8 \uC5BC\uAD74\uC774 <b>\uAC16\uACE0 \uC2F6\uB2E4</b>."
      - "\uAC70\uC6B8\uC744 \uAE7C\uB2E4. \uC190\uBC14\uB2E5\uC774 \uCC22\uC5B4\uC84C\uB2E4.
        \uAE68\uC9C4 \uC870\uAC01\uB9C8\uB2E4 \uB0B4\uAC00 \uC6C3\uB294\uB2E4. \uC88B\uB2E4.
        \uC88B\uB2E4. \uC88B\uB2E4."
      - "\uC774 \uC77C\uAE30\uB97C \uC77D\uB294 \uB204\uAD70\uAC00\uC5D0\uAC8C. <s>\uC704\uCE35\uC73C\uB85C
        \uC624\uC9C0 \uB9C8\uB77C</s> \uC704\uCE35\uC740 \uB0B4 \uAC83\uC774\uB2E4.
        \uC624\uC9C0 \uB9C8\uB77C. \uB0B4 \uAC83\uC774\uB2E4."
      absorbedLine: "(\uB0B4 \uAE00\uC528) \uAC70\uC6B8 \uC18D \uC800\uB3C4 \uC6C3\uACE0
        \uC788\uC5C8\uC5B4\uC694. \uC544\uBC84\uC9C0, \uADF8 \uC5BC\uAD74 \uC800\uB3C4
        \uAC16\uACE0 \uC2F6\uC5B4\uC694."
      refusedLine: "(\uB0B4 \uAE00\uC528) \uAC70\uC6B8\uC740 \uBCF4\uC9C0 \uC54A\uC558\uC5B4\uC694.
        \uC904 \uADF8\uC740 \uAE00\uC528 \uC544\uB798 '\uC624\uC9C0 \uB9C8\uB77C'\uB9CC
        \uC77D\uC744\uAC8C\uC694."
      tilt: 5
      readShards: 12
      patternKind: 38
      patternTainted: 45
      blood: 0.55
      ink: {r: 0.29803923, g: 0.08235294, b: 0.08235294, a: 1}
    - floor: 5
      title: "\uB2E4\uC12F\uC9F8 \uC7A5, \uB05D\uB098\uC9C0 \uC54A\uB294 \uC2DD\uD0C1"
      lines:
      - "\uBC30\uAC00 \uACE0\uD504\uC9C0 \uC54A\uC740\uB370 \uBA39\uC5C8\uB2E4. \uC2DD\uD0C1\uC774
        \uB05D\uB098\uC9C0 \uC54A\uB294\uB2E4. \uC811\uC2DC\uB97C \uBE44\uC6B0\uBA74
        \uB204\uAD70\uAC00 \uB610 \uCC44\uC6B4\uB2E4. \uACE0\uB9D9\uB2E4. \uACE0\uB9D9\uB2E4."
      - "\uC544\uC774\uC758 \uC678\uD22C \uCE58\uC218\uB97C \uC801\uC5B4 \uB454 \uC885\uC774\uB85C
        \uC785\uC744 \uB2E6\uC558\uB2E4. \uC22B\uC790\uAC00 \uBC88\uC84C\uB2E4. <s>\uB2E4\uC2DC
        \uC7AC\uBA74 \uB41C\uB2E4</s> \uD544\uC694 \uC5C6\uB2E4."
      - "\uB204\uC6CC\uC11C \uC2E4\uC744 \uAFF0\uC5C8\uB2E4. \uC77C\uC5B4\uB0A0 \uC774\uC720\uAC00
        \uC5C6\uB2E4. \uBC14\uB298\uC774 \uC800 \uD63C\uC790 \uC6C0\uC9C1\uC778\uB2E4.
        \uB098\uB294 \uBCF4\uAE30\uB9CC \uD558\uBA74 \uB41C\uB2E4."
      - "\uC544\uB798\uCE35\uC5D0\uC11C \uB204\uAC00 \uACC4\uB2E8\uC744 \uC624\uB978\uB2E4.
        \uC791\uC740 \uBC1C\uC18C\uB9AC. <s>\uBC18\uAC11\uB2E4</s> \uB0B4 \uBAAB\uC744
        \uB098\uB220 \uC904 \uC0DD\uAC01\uC740 \uC5C6\uB2E4."
      absorbedLine: "(\uB0B4 \uAE00\uC528) \uC800\uB3C4 \uBC30\uAC00 \uACE0\uD504\uC9C0
        \uC54A\uC740\uB370 \uBA39\uC5C8\uC5B4\uC694. \uB9DB\uC788\uC5C8\uC5B4\uC694,
        \uC544\uBC84\uC9C0."
      refusedLine: "(\uB0B4 \uAE00\uC528) \uC2DD\uD0C1\uC740 \uC9C0\uB098\uCCE4\uC5B4\uC694.
        \uBC88\uC9C4 \uC22B\uC790\uB294 \uC81C\uAC00 \uB2E4\uC2DC \uC7B4\uAC8C\uC694."
      tilt: 4
      readShards: 15
      patternKind: 39
      patternTainted: 46
      blood: 0.7
      ink: {r: 0.31633332, g: 0.077, b: 0.077, a: 1}
    - floor: 6
      title: "\uC5EC\uC12F\uC9F8 \uC7A5, \uB0A8\uC758 \uB4F1\uBD88"
      lines:
      - "\uC717\uCE35 \uC7AC\uBD09\uC0AC\uC758 \uB4F1\uBD88\uC774 \uB0B4 \uAC83\uBCF4\uB2E4
        \uBC1D\uC558\uB2E4. \uAED0\uB2E4. \uC774\uC81C \uB0B4\uAC00 \uAC00\uC7A5
        \uBC1D\uB2E4. \uC544\uB2C8\uB2E4, \uC704\uC5D0 \uB610 \uC788\uB2E4."
      - "\uAE08\uC2E4\uB85C \uB2E8\uCD94\uB97C \uB2EC\uC558\uB2E4. \uAE08\uC2E4\uC740
        \uB04A\uC5B4\uC9C0\uC9C0 \uC54A\uB294\uB2E4. \uB04A\uC5B4\uC9C0\uC9C0 \uC54A\uB294
        \uAC83\uC740 \uBAA8\uB450 <b>\uB0B4 \uAC83</b>\uC774\uC5B4\uC57C \uD55C\uB2E4."
      - "\uC190\uB2D8\uC774 \uB9E1\uAE34 \uC678\uD22C\uB97C \uB3CC\uB824\uC8FC\uC9C0
        \uC54A\uC558\uB2E4. \uB3CC\uB824 \uB2EC\uB77C\uAE30\uC5D0 \uD654\uAC00 \uB0AC\uB2E4.
        \uAC00\uC704\uB97C \uB4E4\uC5C8\uB2E4. \uADF8 \uB4A4\uB294 \uAE30\uC5B5\uB098\uC9C0
        \uC54A\uB294\uB2E4."
      - "<s>\uC544\uC774\uC57C \uBBF8\uC548\uD558\uB2E4</s> \uBBF8\uC548\uD560 \uAC83
        \uC5C6\uB2E4. \uD0D1\uC774 \uADF8\uB807\uAC8C \uB9D0\uD55C\uB2E4. \uB098\uB294
        \uD0D1\uC758 \uB9D0\uC774 \uC88B\uB2E4."
      absorbedLine: "(\uB0B4 \uAE00\uC528) \uAEBC\uC9C4 \uB4F1\uBD88 \uC606\uC5D0
        \uC81C \uB4F1\uBD88\uC744 \uCF30\uC5B4\uC694. \uC544\uBC84\uC9C0 \uAC83\uBCF4\uB2E4
        \uBC1D\uAC8C\uC694."
      refusedLine: "(\uB0B4 \uAE00\uC528) \uAEBC\uC9C4 \uB4F1\uBD88\uC5D0 \uB2E4\uC2DC
        \uBD88\uC744 \uBD99\uC600\uC5B4\uC694. \uC678\uD22C\uB294 \uC8FC\uC778\uC5D0\uAC8C
        \uB3CC\uB824\uC92C\uC5B4\uC694."
      tilt: -6
      readShards: 18
      patternKind: 40
      patternTainted: 47
      blood: 0.85
      ink: {r: 0.33466667, g: 0.072000004, b: 0.072000004, a: 1}
    - floor: 7
      title: "\uC77C\uACF1\uC9F8 \uC7A5, \uD0D1\uC758 \uAF2D\uB300\uAE30"
      lines:
      - "\uAF2D\uB300\uAE30\uC5D0 \uC7AC\uBD09\uD2C0\uC774 \uC788\uB2E4. \uD0D1 \uC804\uCCB4\uAC00
        \uADF8 \uBC14\uB298\uC758 \uD55C \uB540\uC774\uB2E4. \uB0B4 \uD53C\uB85C
        \uC2E4\uC744 \uAFF0\uC5C8\uB2E4. \uC798 \uB4E4\uC5B4\uAC04\uB2E4."
      - "\uB354. \uB354. <b>\uB354 \uB9CE\uC774.</b> \uBAA8\uB450\uC758 \uC695\uB9DD\uC744
        \uC2E4 \uC0BC\uC544 \uAFF0\uB9E8\uB2E4. \uC190\uC774 \uBA48\uCD94\uC9C0 \uC54A\uB294\uB2E4.
        \uBA48\uCD94\uACE0 \uC2F6\uC9C0 \uC54A\uB2E4."
      - "\uADF8 \uC790\uB9AC\uC5D0 \uC549\uC73C\uB77C\uACE0 \uD588\uB2E4. \uC6D0\uD558\uB294
        \uAC83\uC740 \uBB34\uC5C7\uC774\uB4E0 \uC900\uB2E4\uACE0. \uB098\uB294 \uC774\uBBF8
        \uC549\uC544 \uC788\uB2E4. \uC5B8\uC81C\uBD80\uD130\uC600\uC9C0."
      - "\uC544\uC774\uC57C, <s>\uBC14\uB298\uC740 \uB124\uAC00 \uAC00\uC838\uAC00\uAC70\uB77C</s>
        \uBC14\uB298\uC740 \uB0B4 \uAC83\uC774\uB2E4. <s>\uB3C4\uB9DD\uCCD0\uB77C</s>
        ... \uB124 \uC774\uB984\uC774 \uC0DD\uAC01\uB098\uC9C0 \uC54A\uB294\uB2E4."
