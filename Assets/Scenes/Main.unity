    packText: "\uC9C4\uC5F4\uB41C \uC870\uAC01\uC744 \uC7AC\uBD09 \uC0C1\uC790 \uD310\uC5D0
      \uB193\uC73C\uBA74 \uD30C\uD3B8\uC744 \uB0B4\uACE0 \uCC59\uAE41\uB2C8\uB2E4.
      \uB2E4\uC74C \uB4F1\uBC18 \uD55C \uBC88\uB9CC \uB4E4\uACE0 \uAC00\uC694"
    packFoot: "\uCC59\uAE34 \uC870\uAC01 {0} / {1}\uAC1C"
    packTitle: "\uC2DC\uC791 \uC870\uAC01 \uCC59\uAE30\uAE30"
    packHelp: "\uBAA9\uB85D\uC758 \uC870\uAC01\uC744 \uD310\uC5D0 \uB04C\uC5B4 \uB193\uC73C\uBA74
      \uD30C\uD3B8\uC744 \uB0B4\uACE0 \uCC59\uAE41\uB2C8\uB2E4(R \uD68C\uC804). \uD310\uC5D0\uC11C
      \uBE7C\uBA74 \uD30C\uD3B8\uC744 \uB3CC\uB824\uBC1B\uC544\uC694."
